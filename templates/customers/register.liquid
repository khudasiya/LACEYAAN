{%- comment -%}
  LACEYAAN Atelier — Customer Registration
  Official Shopify Classic Customer Account Registration Template
{%- endcomment -%}

<section class="customer-auth-section section-padding">
  <div class="container container-narrow">
    <div class="customer-auth-wrapper">
      <div class="customer-auth-card">
        <div class="auth-card-header text-center">
          <span class="auth-kicker">JOIN THE ROTATION</span>
          <h1 class="auth-title">Create Atelier Account</h1>
          <p class="auth-subtitle">Register to manage your footwear orders, track express shipments, and receive priority access to limited Jacquard capsules.</p>
        </div>

        {%- form 'create_customer', class: 'auth-form', novalidate: 'novalidate' -%}
          {%- if form.errors -%}
            <div class="auth-alert auth-alert-error" tabindex="-1" autofocus>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="auth-row-2col">
            <div class="auth-input-group">
              <label for="RegisterFirstName" class="auth-label">First Name</label>
              <input
                type="text"
                name="customer[first_name]"
                id="RegisterFirstName"
                class="auth-input"
                {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
                autocomplete="given-name"
                placeholder="e.g. Rahul"
                required
              >
            </div>

            <div class="auth-input-group">
              <label for="RegisterLastName" class="auth-label">Last Name</label>
              <input
                type="text"
                name="customer[last_name]"
                id="RegisterLastName"
                class="auth-input"
                {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
                autocomplete="family-name"
                placeholder="e.g. Sharma"
                required
              >
            </div>
          </div>

          <div class="auth-input-group">
            <label for="RegisterEmail" class="auth-label">Email Address</label>
            <input
              type="email"
              name="customer[email]"
              id="RegisterEmail"
              class="auth-input"
              {% if form.email %}value="{{ form.email }}"{% endif %}
              spellcheck="false"
              autocapitalize="off"
              autocomplete="email"
              placeholder="e.g. collector@laceyaan.in"
              required
              {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
            >
          </div>

          <div class="auth-input-group">
            <label for="RegisterPassword" class="auth-label">Create Password</label>
            <input
              type="password"
              name="customer[password]"
              id="RegisterPassword"
              class="auth-input"
              aria-required="true"
              autocomplete="new-password"
              placeholder="Minimum 6 characters"
              required
              {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}
            >
            <span class="auth-hint">Must be at least 6 characters. Passwords are securely hashed by Shopify.</span>
          </div>

          <div class="auth-actions-group">
            <button type="submit" class="btn-primary btn-auth-submit">
              <span>CREATE ATELIER ACCOUNT &rarr;</span>
            </button>
          </div>

          <div class="auth-switch-row text-center">
            <span>Already have an atelier account?</span>
            <a href="{{ routes.account_login_url }}" class="auth-switch-link">Sign In Here &rarr;</a>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

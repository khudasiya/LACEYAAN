{%- comment -%}
  LACEYAAN Atelier — Reset Password Confirmation
  Official Shopify Classic Customer Password Reset
{%- endcomment -%}

<section class="customer-auth-section section-padding">
  <div class="container container-narrow">
    <div class="customer-auth-wrapper">
      <div class="customer-auth-card">
        <div class="auth-card-header text-center">
          <span class="auth-kicker">SECURITY PROTOCOL</span>
          <h1 class="auth-title">Reset Account Password</h1>
          <p class="auth-subtitle">Enter your new password below to secure your atelier account.</p>
        </div>

        {%- form 'reset_customer_password', class: 'auth-form' -%}
          {%- if form.errors -%}
            <div class="auth-alert auth-alert-error" tabindex="-1" autofocus>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="auth-input-group">
            <label for="password" class="auth-label">New Password</label>
            <input
              type="password"
              name="customer[password]"
              id="password"
              class="auth-input"
              autocomplete="new-password"
              placeholder="••••••••••••"
              required
            >
          </div>

          <div class="auth-input-group">
            <label for="password_confirmation" class="auth-label">Confirm New Password</label>
            <input
              type="password"
              name="customer[password_confirmation]"
              id="password_confirmation"
              class="auth-input"
              autocomplete="new-password"
              placeholder="••••••••••••"
              required
            >
          </div>

          <div class="auth-actions-group">
            <button type="submit" class="btn-primary btn-auth-submit">
              <span>RESET PASSWORD &amp; SIGN IN &rarr;</span>
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5">
  <meta name="theme-color" content="#0a0a0a">
  <link rel="canonical" href="{{ canonical_url }}">

  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">

  <title>LACEYAAN &mdash; The Difference Is Coming | Official Drop</title>
  <meta name="description" content="LACEYAAN &mdash; Same Shoes. Different Story. Premium sneaker laces crafted with engineered weaves and laser-etched metal aglets. Launching soon.">

  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% else %}
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
  {% endif %}

  {{ content_for_header }}

  {{ 'coming-soon.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'coming-soon.js' | asset_url }}" defer="defer"></script>
</head>
<body class="laceyaan-coming-soon-body">
  <a class="skip-to-content-link visually-hidden" href="#MainContent">Skip to content</a>

  <header class="ly-topbar">
    <div class="ly-topbar-inner">
      <div class="ly-topbar-brand">
        <img src="{{ 'logo-icon-white.png' | asset_url }}" alt="LACEYAAN Arch Emblem" class="ly-topbar-emblem" width="26" height="26">
        <span class="ly-topbar-title">LACEYAAN</span>
      </div>

      <div class="ly-topbar-badge">
        <span class="ly-status-dot"></span>
        <span class="ly-status-text">DROP 01 // COMING SOON</span>
      </div>

      <div class="ly-topbar-actions">
        <button type="button" class="ly-glow-toggle-btn" id="lyGlowToggle" aria-label="Toggle Phosphor Glow Night Mode">
          <span class="ly-glow-icon">✦</span>
          <span class="ly-glow-toggle-label">GLOW MODE</span>
        </button>
      </div>
    </div>
  </header>

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
</body>
</html>

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_bg_dark | default: '#141311' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Google Typography for Luxury Streetwear Aesthetic -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Google Search & Browser Favicon Suite (Multiples of 48px required by Googlebot) -->
    {%- if settings.favicon != blank -%}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 48, height: 48 }}" sizes="48x48">
      <link rel="icon" type="image/png" sizes="48x48" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
      <link rel="icon" type="image/png" sizes="96x96" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
      <link rel="icon" type="image/png" sizes="144x144" href="{{ settings.favicon | image_url: width: 144, height: 144 }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ settings.favicon | image_url: width: 192, height: 192 }}">
      <link rel="icon" type="image/png" sizes="512x512" href="{{ settings.favicon | image_url: width: 512, height: 512 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
    {%- else -%}
      <link rel="icon" href="{{ 'favicon.ico' | asset_url }}" sizes="any">
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
      <link rel="icon" type="image/png" sizes="48x48" href="{{ 'favicon-48x48.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="96x96" href="{{ 'favicon-96x96.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="144x144" href="{{ 'favicon-144x144.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ 'favicon-192x192.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="512x512" href="{{ 'favicon-512x512.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32x32.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="16x16" href="{{ 'favicon-16x16.png' | asset_url }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">
      <link rel="shortcut icon" href="{{ 'favicon.ico' | asset_url }}">
    {%- endif -%}
    <link rel="manifest" href="{{ 'site.webmanifest' | asset_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <!-- Social Meta Tags -->
    {%- render 'social-meta-tags' -%}

    <!-- Design Tokens / CSS Custom Properties -->
    <style>
      :root {
        --bg-primary: {{ settings.color_bg_primary | default: '#FAF9F5' }};
        --bg-dark: {{ settings.color_bg_dark | default: '#141311' }};
        --bg-dark-surface: {{ settings.color_bg_surface | default: '#1E1D1B' }};
        --text-main: {{ settings.color_text_main | default: '#1E1D1B' }};
        --text-light: {{ settings.color_text_light | default: '#FAF9F5' }};
        --text-sub: #6A675F;
        --accent-gold: {{ settings.color_accent_gold | default: '#C5A880' }};
        --accent-gold-dark: {{ settings.color_accent_gold_dark | default: '#A38760' }};
        --accent-gold-light: #E0C7A6;
        --border-light: rgba(0, 0, 0, 0.08);
        --border-dark: rgba(255, 255, 255, 0.1);
        --font-serif: 'Playfair Display', Georgia, serif;
        --font-editorial: 'Cormorant Garamond', Georgia, serif;
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-heading: 'Outfit', 'Space Grotesk', sans-serif;
        --font-grotesk: 'Space Grotesk', sans-serif;
        --font-mono: 'Space Mono', SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        --radius-xs: 2px;
        --radius-sm: 4px;
        --radius-full: 9999px;
        --transition-fast: 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        --transition-smooth: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        --shadow-sm: 0 2px 8px rgba(20, 19, 17, 0.04);
        --shadow-md: 0 8px 24px rgba(20, 19, 17, 0.08);
        --shadow-lg: 0 16px 40px rgba(20, 19, 17, 0.12);
      }
    </style>

    <!-- Theme Stylesheet -->
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | default: 'Error updating bag' }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | default: 'You can only add [quantity] of this item' }}`
      };
    </script>
  </head>

  <body class="template-{{ template.name | default: 'index' | handle }}">
    <a class="skip-to-content-link visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    <!-- Animated Background Shoelace Streamer -->
    {% render 'background-lace' %}

    <!-- Sticky Announcement Bar & Header -->
    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Footer Group -->
    {% sections 'footer-group' %}

    <!-- Global Cart Drawer -->
    {% render 'cart-drawer' %}

    <!-- Global Quick View Modal -->
    {% render 'quick-view-modal' %}

    <!-- Global Live Search Modal -->
    {% render 'search-modal' %}

    <!-- Toast Notification Container -->
    <div id="toast-container" class="toast-container" aria-live="polite"></div>

    <!-- Theme JavaScript -->
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>

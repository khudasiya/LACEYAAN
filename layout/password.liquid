<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_bg_dark | default: '#141311' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Google Typography for Luxury Streetwear Aesthetic -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32x32.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ 'favicon.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
    {%- endif -%}

    {%- assign shop_display_name = shop.name -%}
    {%- if shop_display_name == 'My Store' or shop_display_name == blank -%}
      {%- assign shop_display_name = 'LACEYAAN' -%}
    {%- endif -%}

    <title>LACEYAAN &mdash; Elevate Every Step | Luxury Shoelaces</title>

    <meta name="description" content="LACEYAAN &mdash; Elevate Every Step. Precision sneaker laces crafted with engineered weaves and solid CNC milled brass aglets.">

    <script>
      // Clean URL in browser address bar from /password to root /
      if (window.location.pathname.indexOf('/password') !== -1) {
        try {
          window.history.replaceState(null, 'LACEYAAN \u2014 Elevate Every Step | Luxury Shoelaces', '/');
        } catch (e) {}
      }
    </script>

    <!-- Social Meta Tags -->
    {%- render 'social-meta-tags' -%}

    <!-- Design Tokens / CSS Custom Properties -->
    <style>
      :root {
        --bg-primary: {{ settings.color_bg_primary | default: '#FAF9F5' }};
        --bg-dark: {{ settings.color_bg_dark | default: '#141311' }};
        --bg-dark-surface: {{ settings.color_bg_surface | default: '#1E1D1B' }};
        --text-main: {{ settings.color_text_main | default: '#1E1D1B' }};
        --text-light: {{ settings.color_text_light | default: '#FAF9F5' }};
        --text-sub: #6A675F;
        --accent-gold: {{ settings.color_accent_gold | default: '#C5A880' }};
        --accent-gold-dark: {{ settings.color_accent_gold_dark | default: '#A38760' }};
        --accent-gold-light: #E0C7A6;
        --border-light: rgba(0, 0, 0, 0.08);
        --border-dark: rgba(255, 255, 255, 0.1);
        --font-serif: 'Playfair Display', Georgia, serif;
        --font-editorial: 'Cormorant Garamond', Georgia, serif;
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-heading: 'Outfit', 'Space Grotesk', sans-serif;
        --font-grotesk: 'Space Grotesk', sans-serif;
        --font-mono: 'Space Mono', SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        --radius-xs: 2px;
        --radius-sm: 4px;
        --radius-full: 9999px;
        --transition-fast: 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        --transition-smooth: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        --shadow-sm: 0 2px 8px rgba(20, 19, 17, 0.04);
        --shadow-md: 0 8px 24px rgba(20, 19, 17, 0.08);
        --shadow-lg: 0 16px 40px rgba(20, 19, 17, 0.12);
      }
    </style>

    <!-- Theme Stylesheet -->
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | default: 'Error updating bag' }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | default: 'You can only add [quantity] of this item' }}`
      };
    </script>
  </head>

  <body class="template-index template-live">
    <a class="skip-to-content-link visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    <!-- Storefront Password Quick-Unlock Banner (Visible only while password protection is enabled in Shopify Admin) -->
    <div id="passwordUnlockBar" style="background: #141311; border-bottom: 1px solid rgba(197, 168, 128, 0.45); padding: 7px 16px; font-family: var(--font-mono); font-size: 0.72rem; color: #FAF9F5; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; z-index: 100000; position: relative;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: var(--accent-gold); font-size: 0.85rem;">🔒</span>
        <span><strong>STORE ACCESS LOCKED BY SHOPIFY:</strong> Enter password to unlock individual buy pages &amp; collection catalog.</span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        {% form 'storefront_password', id: 'QuickUnlockForm', style: 'display: flex; gap: 6px; align-items: center; margin: 0;' %}
          {% if form.errors %}
            <span style="color: #ff6b6b; font-size: 0.7rem; font-weight: 700;">Incorrect Password</span>
          {% endif %}
          <input type="password" name="password" placeholder="Enter store password" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(197, 168, 128, 0.4); color: #fff; padding: 4px 8px; font-size: 0.72rem; border-radius: 2px;" required>
          <button type="submit" name="commit" style="background: var(--accent-gold); color: #141311; border: none; padding: 4px 10px; font-weight: 700; font-size: 0.72rem; border-radius: 2px; cursor: pointer;">UNLOCK STORE &rarr;</button>
        {% endform %}
        <a href="/admin" target="_blank" rel="noopener noreferrer" style="color: var(--accent-gold-light); text-decoration: underline; font-size: 0.7rem; margin-left: 6px;">Shopify Admin &rarr;</a>
      </div>
    </div>

    <!-- Animated Background Shoelace Streamer -->
    {% render 'background-lace' %}

    <!-- Sticky Announcement Bar & Header -->
    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Footer Group -->
    {% sections 'footer-group' %}

    <!-- Global Cart Drawer -->
    {% render 'cart-drawer' %}

    <!-- Global Quick View Modal -->
    {% render 'quick-view-modal' %}

    <!-- Global Live Search Modal -->
    {% render 'search-modal' %}

    <!-- Global Studio Exploration Portals Modals -->
    {% render 'portal-modals' %}

    <!-- Global Register Interest Admin Modal -->
    {% render 'interest-admin-modal' %}

    <!-- Toast Notification Container -->
    <div id="toast-container" class="toast-container" aria-live="polite"></div>

    <script>
      (function() {
        function ensureRegisterInterestNav() {
          var desktopList = document.querySelector('.desktop-nav .nav-links-list');
          if (desktopList && !desktopList.querySelector('.nav-item-interest')) {
            var li = document.createElement('li');
            li.className = 'nav-item nav-item-interest';
            li.innerHTML = '<a href="/collections/register-interest" class="nav-link nav-link-interest"><span>Register Interest</span><span class="nav-interest-pill">VOTE</span></a>';
            desktopList.appendChild(li);
          }
          var mobileList = document.querySelector('.mobile-nav-list');
          if (mobileList && !mobileList.querySelector('.mobile-nav-group-interest')) {
            var div = document.createElement('div');
            div.className = 'mobile-nav-group mobile-nav-group-interest';
            div.innerHTML = '<a href="/collections/register-interest" class="mobile-nav-link mobile-nav-link-interest"><span>Register Interest</span><span class="nav-interest-pill">VOTE</span></a>';
            mobileList.appendChild(div);
          }

          document.querySelectorAll('.nav-link-interest, .mobile-nav-link-interest').forEach(function(link) {
            link.addEventListener('click', function(e) {
              var vault = document.getElementById('register-interest-vault');
              if (vault) {
                e.preventDefault();
                vault.scrollIntoView({ behavior: 'smooth', block: 'start' });
                var mobileDrawer = document.getElementById('mobile-drawer');
                if (mobileDrawer) mobileDrawer.classList.remove('is-open');
                try {
                  window.history.pushState(null, '', '#register-interest-vault');
                } catch(err) {}
              }
            });
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', ensureRegisterInterestNav);
        } else {
          ensureRegisterInterestNav();
        }
      })();
    </script>

    <!-- Hidden Storefront Password Form for Shopify Theme Spec Compliance -->
    <div style="display:none;" aria-hidden="true">
      {% form 'storefront_password' %}
        <input type="password" name="password" id="HiddenPassword">
        <button type="submit">Unlock</button>
      {% endform %}
    </div>

    <!-- Theme JavaScript -->
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>

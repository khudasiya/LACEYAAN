<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#070707">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Google Typography -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@400;600;700;800&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">

    <!-- Google Search & Browser Favicon Suite -->
    {%- if settings.favicon != blank -%}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 48, height: 48 }}" sizes="48x48">
      <link rel="icon" type="image/png" sizes="48x48" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
      <link rel="icon" type="image/png" sizes="96x96" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
      <link rel="icon" type="image/png" sizes="144x144" href="{{ settings.favicon | image_url: width: 144, height: 144 }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ settings.favicon | image_url: width: 192, height: 192 }}">
      <link rel="icon" type="image/png" sizes="512x512" href="{{ settings.favicon | image_url: width: 512, height: 512 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
    {%- else -%}
      <link rel="icon" href="{{ 'favicon.ico' | asset_url }}" sizes="any">
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
      <link rel="icon" type="image/png" sizes="48x48" href="{{ 'favicon-48x48.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="96x96" href="{{ 'favicon-96x96.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="144x144" href="{{ 'favicon-144x144.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ 'favicon-192x192.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="512x512" href="{{ 'favicon-512x512.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32x32.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="16x16" href="{{ 'favicon-16x16.png' | asset_url }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">
      <link rel="shortcut icon" href="{{ 'favicon.ico' | asset_url }}">
    {%- endif -%}

    <title>
      LACEYAAN &mdash; The Difference Is Coming | Official Drop
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- else -%}
      <meta name="description" content="LACEYAAN &mdash; Same Shoes. Different Story. Premium sneaker laces crafted with engineered weaves and laser-etched metal aglets. Dropping Soon.">
    {%- endif -%}

    <!-- Social Meta Tags -->
    {%- render 'social-meta-tags' -%}

    <!-- Coming Soon Dedicated Stylesheet -->
    {{ 'coming-soon.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <script src="{{ 'coming-soon.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="laceyaan-coming-soon-body template-password">
    <!-- Top Navigation Bar Matching Screenshot 1 -->
    <header class="ly-topbar">
      <div class="ly-topbar-inner">
        <a href="/" class="ly-topbar-brand" aria-label="LACEYAAN Home">
          <img src="{{ 'logo-icon-white.png' | asset_url }}" alt="LACEYAAN Arch Emblem" class="ly-topbar-emblem" width="22" height="22">
          <span class="ly-topbar-title">LACEYAAN</span>
        </a>

        <div class="ly-topbar-badge">
          <span class="ly-status-dot"></span>
          <span class="ly-status-text">DROP 01 // COMING SOON</span>
        </div>

        <div class="ly-topbar-actions">
          <a href="https://www.instagram.com/laceyaan_/" target="_blank" rel="noopener noreferrer" class="ly-topbar-insta" aria-label="Follow @laceyaan_ on Instagram" title="Follow @laceyaan_ on Instagram">
            <svg class="icon icon-instagram" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            <span>@laceyaan_</span>
          </a>
          <button type="button" class="ly-password-trigger-btn" id="lyPasswordTrigger" aria-haspopup="dialog" aria-label="Enter store using password" title="Enter store using password">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span>ENTER</span>
          </button>
        </div>
      </div>
    </header>

    <main id="MainContent" class="password-main" role="main">
      {{ content_for_layout }}
    </main>

    <!-- Storefront Password Unlock Modal -->
    <div class="ly-password-modal{% if form.errors %} is-open{% endif %}" id="lyPasswordModal" role="dialog" aria-modal="true" aria-hidden="{% if form.errors %}false{% else %}true{% endif %}">
      <div class="ly-password-overlay" id="lyPasswordOverlay"></div>
      <div class="ly-password-box">
        <button type="button" class="ly-password-close" id="lyPasswordClose" aria-label="Close Password Dialog">&times;</button>
        <div class="ly-password-header">
          <img src="{{ 'logo-icon-white.png' | asset_url }}" alt="LACEYAAN" width="32" height="32">
          <h3>STORE ACCESS</h3>
          <p>Enter storefront password to preview full catalog</p>
        </div>
        {% form 'storefront_password', class: 'ly-password-form', id: 'StorefrontPasswordForm' %}
          {% if form.errors %}
            <div class="ly-form-error" role="alert" style="display: block; color: #ff5555; background: rgba(255, 85, 85, 0.1); border: 1px solid rgba(255, 85, 85, 0.3); border-radius: 6px; padding: 10px 14px; margin-bottom: 14px; font-size: 0.85rem; text-align: left;">
              {{ form.errors | default_errors }}
            </div>
            <script>
              window.addEventListener('DOMContentLoaded', function() {
                var modal = document.getElementById('lyPasswordModal');
                if (modal) {
                  modal.classList.add('is-open');
                  modal.setAttribute('aria-hidden', 'false');
                  var inp = modal.querySelector('input[type="password"]');
                  if (inp) setTimeout(function() { inp.focus(); }, 150);
                }
              });
            </script>
          {% endif %}
          <div class="ly-input-wrap">
            <input type="password" name="password" id="Password" class="ly-input-field" placeholder="Enter storefront password" autocomplete="current-password" autofocus required>
            <button type="submit" name="commit" class="ly-btn-submit">ENTER</button>
          </div>
          <div class="ly-password-owner-hint" style="margin-top: 18px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.08); font-size: 0.76rem; color: #888; text-align: center;">
            <span>Store owner?</span> <a href="/admin" style="color: #fff; text-decoration: underline; margin-left: 4px;">Log in to Shopify Admin &rarr;</a>
          </div>
        {% endform %}
      </div>
    </div>
  </body>
</html>

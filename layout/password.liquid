<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5">
    <meta name="theme-color" content="#070707">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Google Typography -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32x32.png' | asset_url }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ 'favicon.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
    {%- endif -%}

    <title>
      LACEYAAN &mdash; The Difference Is Coming | Official Drop
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- else -%}
      <meta name="description" content="LACEYAAN &mdash; Same Shoes. Different Story. Premium sneaker laces crafted with engineered weaves and laser-etched metal aglets. Dropping September 24.">
    {%- endif -%}

    <!-- Social Meta Tags -->
    {%- render 'social-meta-tags' -%}

    <!-- Coming Soon Theme Stylesheet -->
    {{ 'coming-soon.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <script src="{{ 'coming-soon.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="laceyaan-coming-soon-body template-password">
    <header class="ly-topbar">
      <div class="ly-topbar-inner">
        <a href="/" class="ly-topbar-brand" aria-label="LACEYAAN Home">
          <img src="{{ 'logo-icon-white.png' | asset_url }}" alt="LACEYAAN Arch Emblem" class="ly-topbar-emblem" width="24" height="24">
          <span class="ly-topbar-title">LACEYAAN</span>
        </a>

        <div class="ly-topbar-badge">
          <span class="ly-status-dot"></span>
          <span class="ly-status-text">DROP 01 // DROPPING SEPTEMBER 24</span>
        </div>

        <div class="ly-topbar-actions">
          <button type="button" class="ly-glow-toggle-btn" id="lyGlowToggle" aria-label="Toggle Phosphor Glow Night Mode">
            <span class="ly-glow-icon">✦</span>
            <span class="ly-glow-toggle-label">GLOW</span>
          </button>
          <button type="button" class="ly-password-trigger-btn" id="lyPasswordTrigger" aria-label="Store Owner Password Access" title="Store Access">
            <span class="ly-lock-icon">🔒</span>
            <span class="ly-password-label">STORE ACCESS</span>
          </button>
        </div>
      </div>
    </header>

    <main id="MainContent" class="password-main" role="main">
      {{ content_for_layout }}
    </main>

    <!-- Storefront Password Unlock Modal -->
    <div class="ly-password-modal" id="lyPasswordModal" role="dialog" aria-modal="true" aria-hidden="true">
      <div class="ly-password-overlay" id="lyPasswordOverlay"></div>
      <div class="ly-password-box">
        <button type="button" class="ly-password-close" id="lyPasswordClose" aria-label="Close Password Dialog">&times;</button>
        <div class="ly-password-header">
          <img src="{{ 'logo-icon-white.png' | asset_url }}" alt="LACEYAAN" width="32" height="32">
          <h3>STORE ACCESS</h3>
          <p>Enter storefront password to preview full catalog</p>
        </div>
        {% form 'storefront_password', class: 'ly-password-form' %}
          {% if form.errors %}
            <div class="ly-form-error">{{ form.errors | default_errors }}</div>
          {% endif %}
          <div class="ly-input-wrap">
            <input type="password" name="password" id="StorefrontPassword" class="ly-input-field" placeholder="Enter password" autofocus required>
            <button type="submit" class="ly-btn-submit">ENTER</button>
          </div>
        {% endform %}
      </div>
    </div>
  </body>
</html>

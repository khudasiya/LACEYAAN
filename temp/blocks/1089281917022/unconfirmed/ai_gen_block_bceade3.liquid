{% doc %}
  @prompt
    add the home page collection products here 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign featured_collection = block.settings.collection %}

{% style %}
  .ai-collection-products-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #1E1D1B;
  }

  .ai-collection-products-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: #1E1D1B;
    font-size: clamp(22px, 3vw, 32px);
    line-height: 1.2;
    font-weight: 500;
  }

  .ai-collection-products-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 20px;
  }

  .ai-collection-products-{{ ai_gen_id }}__card {
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .ai-collection-products-{{ ai_gen_id }}__media {
    position: relative;
    overflow: hidden;
    background: #FAF9F5;
    aspect-ratio: 4 / 5;
  }

  .ai-collection-products-{{ ai_gen_id }}__media img,
  .ai-collection-products-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-products-{{ ai_gen_id }}__details {
    padding-top: 12px;
  }

  .ai-collection-products-{{ ai_gen_id }}__title {
    margin: 0 0 6px;
    color: #1E1D1B;
    font-size: 15px;
    line-height: 1.4;
    font-weight: 500;
  }

  .ai-collection-products-{{ ai_gen_id }}__price {
    color: #1E1D1B;
    font-size: 14px;
  }

  .ai-collection-products-{{ ai_gen_id }}__vendor {
    margin: 0 0 5px;
    color: #5E5B56;
    font-size: 12px;
    letter-spacing: .04em;
  }

  .ai-collection-products-{{ ai_gen_id }}__empty {
    padding: 32px 20px;
    background: #FAF9F5;
    color: #5E5B56;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-products-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 12px;
    }
  }
{% endstyle %}

<div class="ai-collection-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if featured_collection != blank %}
    {% assign section_heading = block.settings.heading | default: featured_collection.title %}
    {% if section_heading != blank %}
      <h2 class="ai-collection-products-{{ ai_gen_id }}__heading">{{ section_heading | escape }}</h2>
    {% endif %}

    {% if featured_collection.products.size > 0 %}
      <div class="ai-collection-products-{{ ai_gen_id }}__grid">
        {% for product in featured_collection.products limit: block.settings.products_to_show %}
          <a class="ai-collection-products-{{ ai_gen_id }}__card" href="{{ product.url }}">
            <div class="ai-collection-products-{{ ai_gen_id }}__media">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {% else %}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="ai-collection-products-{{ ai_gen_id }}__details">
              {% if block.settings.show_vendor and product.vendor != blank %}
                <p class="ai-collection-products-{{ ai_gen_id }}__vendor">{{ product.vendor | escape }}</p>
              {% endif %}
              <h3 class="ai-collection-products-{{ ai_gen_id }}__title">{{ product.title | escape }}</h3>
              <div class="ai-collection-products-{{ ai_gen_id }}__price">
                {% if product.compare_at_price > product.price %}
                  <s>{{ product.compare_at_price | money }}</s> <span>{{ product.price | money }}</span>
                {% else %}
                  {{ product.price | money }}
                {% endif %}
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-collection-products-{{ ai_gen_id }}__empty">This collection has no products to display yet.</div>
    {% endif %}
  {% else %}
    <div class="ai-collection-products-{{ ai_gen_id }}__empty">Choose a collection in the block settings to display its products.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Collection products"
    }
  ],
  "tag": null,
  "class": "collection-products-block"
}
{% endschema %}
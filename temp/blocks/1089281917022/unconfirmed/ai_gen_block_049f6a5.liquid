{% doc %}
  @prompt
    add the "home page" collection product here and show here 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-home-collection-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 32px 20px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-home-collection-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-home-collection-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.heading_alignment }};
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.2;
  }

  .ai-home-collection-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 20px;
  }

  .ai-home-collection-{{ ai_gen_id }}__card {
    min-width: 0;
    color: {{ block.settings.text_color }};
    text-decoration: none;
  }

  .ai-home-collection-{{ ai_gen_id }}__image-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #f0eee9;
    aspect-ratio: 4 / 5;
  }

  .ai-home-collection-{{ ai_gen_id }}__image-wrap img,
  .ai-home-collection-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-home-collection-{{ ai_gen_id }}__details {
    padding-top: 12px;
  }

  .ai-home-collection-{{ ai_gen_id }}__product-title {
    margin: 0 0 6px;
    font-size: 15px;
    line-height: 1.4;
    font-weight: 500;
  }

  .ai-home-collection-{{ ai_gen_id }}__price {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 14px;
  }

  .ai-home-collection-{{ ai_gen_id }}__empty {
    padding: 48px 20px;
    background: #f0eee9;
    color: #494640;
    text-align: center;
    line-height: 1.6;
  }

  .ai-home-collection-{{ ai_gen_id }}__empty p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-home-collection-{{ ai_gen_id }} {
      padding: 24px 16px;
    }

    .ai-home-collection-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 12px;
    }
  }
{% endstyle %}

<div class="ai-home-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-home-collection-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-home-collection-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    {% if block.settings.collection != blank and block.settings.collection.products.size > 0 %}
      <div class="ai-home-collection-{{ ai_gen_id }}__grid">
        {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
          <a class="ai-home-collection-{{ ai_gen_id }}__card" href="{{ product.url }}">
            <div class="ai-home-collection-{{ ai_gen_id }}__image-wrap">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {% else %}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="ai-home-collection-{{ ai_gen_id }}__details">
              <h3 class="ai-home-collection-{{ ai_gen_id }}__product-title">{{ product.title | escape }}</h3>
              <p class="ai-home-collection-{{ ai_gen_id }}__price">{{ product.price | money }}</p>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-home-collection-{{ ai_gen_id }}__empty">
        <p>Select your “home page” collection in this block’s settings to display its products here.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Home collection products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1E1D1B"
    }
  ],
  "presets": [
    {
      "name": "Home collection products"
    }
  ],
  "tag": null,
  "class": "home-collection-products"
}
{% endschema %}
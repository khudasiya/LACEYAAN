{% doc %}
  @prompt
    add one block for black friday sales , special pair offers , add one button to go in pairs ., write black friday with black and make the background according to that
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-black-friday-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
    border: 1px solid {{ block.settings.border_color }};
  }

  .ai-black-friday-{{ ai_gen_id }}__content {
    max-width: 760px;
    margin: 0 auto;
  }

  .ai-black-friday-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 10px;
    color: {{ block.settings.text_color }};
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ai-black-friday-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: clamp(28px, 5vw, {{ block.settings.heading_size }}px);
    line-height: 1.1;
    font-weight: 700;
  }

  .ai-black-friday-{{ ai_gen_id }}__text {
    margin: 14px 0 0;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-black-friday-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 22px;
    padding: 13px 24px;
    border: 1px solid {{ block.settings.button_background }};
    border-radius: 2px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-decoration: none;
  }

  .ai-black-friday-{{ ai_gen_id }}__button:hover {
    background: transparent;
    color: {{ block.settings.text_color }};
  }

  .ai-black-friday-{{ ai_gen_id }}__button:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 4px;
  }

  .ai-black-friday-{{ ai_gen_id }}__button svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }

  @media screen and (max-width: 749px) {
    .ai-black-friday-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.mobile_padding }}px 20px;
    }
  }
{% endstyle %}

<div class="ai-black-friday-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-black-friday-{{ ai_gen_id }}__content">
    {% if block.settings.eyebrow != blank %}
      <p class="ai-black-friday-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if block.settings.heading != blank %}
      <h2 class="ai-black-friday-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    {% if block.settings.description != blank %}
      <p class="ai-black-friday-{{ ai_gen_id }}__text">{{ block.settings.description | escape }}</p>
    {% endif %}
    {% if block.settings.button_link != blank %}
      <a class="ai-black-friday-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">
        <span>{{ block.settings.button_label | escape }}</span>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
          <path d="M3.5 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Black Friday pairs",
  "settings": [
    {
      "type": "header",
      "content": "Offer content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Offer label",
      "default": "Black Friday"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Special pair offers"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our special offers on pairs and find your perfect match."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop pair offers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Pairs page link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Desktop padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile padding",
      "min": 15,
      "max": 45,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#C5A880"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#141311"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#141311"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#141311"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FAF9F5"
    }
  ],
  "presets": [
    {
      "name": "Black Friday pairs"
    }
  ],
  "tag": null,
  "class": "black-friday-pairs-block"
}
{% endschema %}
{% doc %}
  @prompt
    Create a product image gallery for the current product, with a large main photo on the right and a narrow vertical column of clickable thumbnail images on the left. Clicking a thumbnail updates the main photo. Use the current product's images automatically, preserve image proportions, highlight the selected thumbnail, and support keyboard navigation with accessible labels. Keep the thumbnails beside the main image on mobile too, using smaller thumbnails so the main photo remains prominent. Match the existing theme styling. This gallery is intended to replace the existing product image gallery, not duplicate it.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-product-gallery-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; }
  .ai-product-gallery-{{ ai_gen_id }}__layout { display: grid; grid-template-columns: {{ block.settings.thumbnail_size }}px minmax(0, 1fr); gap: 12px; align-items: start; width: 100%; }
  .ai-product-gallery-{{ ai_gen_id }}__rail { display: flex; flex-direction: column; gap: 8px; max-height: 80vh; overflow-y: auto; scrollbar-width: thin; }
  .ai-product-gallery-{{ ai_gen_id }}__thumb { display: block; flex: 0 0 auto; width: 100%; padding: 0; border: 1px solid transparent; background: transparent; cursor: pointer; line-height: 0; }
  .ai-product-gallery-{{ ai_gen_id }}__thumb[aria-pressed="true"] { border-color: {{ block.settings.selected_border_color }}; }
  .ai-product-gallery-{{ ai_gen_id }}__thumb:focus-visible { outline: 2px solid {{ block.settings.selected_border_color }}; outline-offset: 2px; position: relative; z-index: 1; }
  .ai-product-gallery-{{ ai_gen_id }}__thumb img { display: block; width: 100%; height: auto; object-fit: contain; }
  .ai-product-gallery-{{ ai_gen_id }}__main { min-width: 0; margin: 0; }
  .ai-product-gallery-{{ ai_gen_id }}__main-image { display: block; width: 100%; height: auto; object-fit: contain; }
  .ai-product-gallery-{{ ai_gen_id }}__placeholder { display: flex; position: relative; min-height: 280px; align-items: center; justify-content: center; background: {{ block.settings.placeholder_background }}; }
  .ai-product-gallery-{{ ai_gen_id }}__placeholder svg { display: block; width: 100%; height: auto; max-height: 600px; }
  .ai-product-gallery-{{ ai_gen_id }}__empty-state { position: absolute; bottom: 12px; left: 12px; right: 12px; color: {{ block.settings.placeholder_text_color }}; font-size: 13px; line-height: 1.4; text-align: center; }
  @media screen and (max-width: 749px) {
    .ai-product-gallery-{{ ai_gen_id }}__layout { grid-template-columns: {{ block.settings.mobile_thumbnail_size }}px minmax(0, 1fr); gap: 8px; }
    .ai-product-gallery-{{ ai_gen_id }}__rail { gap: 6px; max-height: 75vh; }
  }
{% endstyle %}
<product-image-gallery-{{ ai_gen_id }} class="ai-product-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if product != blank and product.images.size > 0 %}
    <div class="ai-product-gallery-{{ ai_gen_id }}__layout">
      <div class="ai-product-gallery-{{ ai_gen_id }}__rail" role="group" aria-label="Product images">
        {% for image in product.images %}
          <button class="ai-product-gallery-{{ ai_gen_id }}__thumb" type="button" aria-label="Show image {{ forloop.index }} of {{ product.images.size }}: {{ image.alt | default: product.title | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-image-src="{{ image | image_url: width: 1800 }}" data-image-alt="{{ image.alt | default: product.title | escape }}" data-image-width="{{ image.width }}" data-image-height="{{ image.height }}" {% if forloop.first %}aria-current="true"{% endif %}>
            <img src="{{ image | image_url: width: 180 }}" alt="" width="{{ image.width }}" height="{{ image.height }}" loading="lazy">
          </button>
        {% endfor %}
      </div>
      {% assign first_image = product.images.first %}
      <figure class="ai-product-gallery-{{ ai_gen_id }}__main">
        <img class="ai-product-gallery-{{ ai_gen_id }}__main-image" src="{{ first_image | image_url: width: 1800 }}" alt="{{ first_image.alt | default: product.title | escape }}" width="{{ first_image.width }}" height="{{ first_image.height }}" fetchpriority="high">
      </figure>
    </div>
  {% else %}
    <div class="ai-product-gallery-{{ ai_gen_id }}__placeholder">
      {{ 'product-apparel-1' | placeholder_svg_tag }}
      <div class="ai-product-gallery-{{ ai_gen_id }}__empty-state">Product images will appear here when this block is used on a product page.</div>
    </div>
  {% endif %}
</product-image-gallery-{{ ai_gen_id }}>
<script>
  (() => {
    const elementName = 'product-image-gallery-{{ ai_gen_id }}';
    if (customElements.get(elementName)) return;
    class ProductImageGallery{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.buttons = Array.from(this.querySelectorAll('.ai-product-gallery-{{ ai_gen_id }}__thumb'));
        this.mainImage = this.querySelector('.ai-product-gallery-{{ ai_gen_id }}__main-image');
        if (!this.mainImage || !this.buttons.length) return;
        this.buttons.forEach((button, index) => {
          button.addEventListener('click', () => this.selectImage(index));
          button.addEventListener('keydown', (event) => {
            let next = null;
            if (event.key === 'ArrowDown' || event.key === 'ArrowRight') next = (index + 1) % this.buttons.length;
            if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') next = (index - 1 + this.buttons.length) % this.buttons.length;
            if (event.key === 'Home') next = 0;
            if (event.key === 'End') next = this.buttons.length - 1;
            if (next !== null) { event.preventDefault(); this.buttons[next].focus(); this.selectImage(next); }
          });
        });
      }
      selectImage(index) {
        const button = this.buttons[index];
        if (!button) return;
        this.mainImage.src = button.dataset.imageSrc;
        this.mainImage.alt = button.dataset.imageAlt;
        this.mainImage.width = button.dataset.imageWidth;
        this.mainImage.height = button.dataset.imageHeight;
        this.buttons.forEach((item, itemIndex) => {
          const selected = itemIndex === index;
          item.setAttribute('aria-pressed', String(selected));
          if (selected) item.setAttribute('aria-current', 'true');
          else item.removeAttribute('aria-current');
        });
      }
    }
    customElements.define(elementName, ProductImageGallery{{ ai_gen_id }});
  })();
</script>
{% schema %}
{
  "name": "Product image gallery",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "thumbnail_size", "label": "Thumbnail width", "min": 40, "max": 120, "step": 5, "unit": "px", "default": 70 },
    { "type": "range", "id": "mobile_thumbnail_size", "label": "Mobile thumbnail width", "min": 32, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "color", "id": "selected_border_color", "label": "Selected thumbnail border", "default": "#A38760" },
    { "type": "color", "id": "placeholder_background", "label": "Placeholder background", "default": "#FAF9F5" },
    { "type": "color", "id": "placeholder_text_color", "label": "Placeholder text", "default": "#1E1D1B" }
  ],
  "presets": [{ "name": "Product image gallery" }],
  "tag": null,
  "class": "product-image-gallery-block"
}
{% endschema %}
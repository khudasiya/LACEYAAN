{%- comment -%}
  ALCE Design Lab Seasonal Capsule Spotlight with Sticky Presentation Card and 2x2 Grid
{%- endcomment -%}

<section id="design-lab" class="design-lab-section section-padding" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section-header text-center">
      {%- if section.settings.badge != blank -%}
        <div class="design-lab-badge">
          {% render 'icon-sparkles' %}
          <span>{{ section.settings.badge }}</span>
        </div>
      {%- endif -%}
      <h2 class="editorial-heading">{{ section.settings.heading }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="lab-showcase-grid">
      <!-- Sticky Media Presentation Card -->
      <div class="lab-media-card">
        <div class="lab-image-container">
          {%- if section.settings.box_image != blank -%}
            {{ section.settings.box_image | image_url: width: 1000 | image_tag: 
              class: 'lab-hero-photo', 
              widths: '500, 750, 1000',
              alt: section.settings.heading | escape 
            }}
          {%- else -%}
            <img src="{{ 'design-lab-collection.jpg' | asset_url }}" alt="ALCE Design Lab S'25 Capsule Presentation Box" class="lab-hero-photo" width="600" height="700" loading="lazy">
          {%- endif -%}

          <div class="lab-overlay-tag">
            <span class="vault-tag">ALCE DESIGN LAB &bull; S'25 ARCHIVE</span>
            <span class="vault-edition">Limited to 500 Numbered Sets</span>
          </div>
        </div>

        {%- if section.settings.box_product != blank -%}
          {%- assign box_item = section.settings.box_product -%}
          <div class="vault-quick-bar">
            <div class="vault-info">
              <h4>{{ box_item.title }}</h4>
              <span class="vault-save">Includes all 4 designer laces &bull; Save ₹900</span>
            </div>
            <div class="vault-cta-group">
              <div class="vault-price">
                <span class="price-now">{{ box_item.price | money }}</span>
                {%- if box_item.compare_at_price > box_item.price -%}
                  <span class="price-was">{{ box_item.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
              <button 
                type="button" 
                class="btn-gold btn-sm" 
                data-add-to-cart 
                data-variant-id="{{ box_item.selected_or_first_available_variant.id }}"
              >
                {% render 'icon-shopping-bag' %}
                <span>Get 4-Pack Vault</span>
              </button>
            </div>
          </div>
        {%- endif -%}

        <!-- Capsule Craft Perks -->
        <div class="vault-perks-list">
          <div class="vault-perk-item">
            {% render 'icon-check' %}
            <span>4 High-Density Shuttle Looms: Leopard, Baroque, Damier &amp; Plum</span>
          </div>
          <div class="vault-perk-item">
            {% render 'icon-check' %}
            <span>Individually coated aglets: Ceramic White, Matte Black, Olive &amp; Plum</span>
          </div>
          <div class="vault-perk-item">
            {% render 'icon-check' %}
            <span>Embossed matte black archival collector magnetic box</span>
          </div>
        </div>
      </div>

      <!-- Symmetrical 2x2 Individual Laces Column -->
      <div class="lab-details-col">
        <div class="lab-intro-box">
          <h3>The 4 Jacquard Silhouettes</h3>
          <p>
            Each lace in this capsule is woven on high-tension Jacquard shuttle looms rather than 
            printed, ensuring three-dimensional texture that never fades or wrinkles.
          </p>
        </div>

        <div class="individual-laces-grid">
          {%- assign lab_col = collections[section.settings.capsule_collection] -%}
          {%- if lab_col != blank and lab_col.products_count > 0 -%}
            {%- for product in lab_col.products limit: 4 -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="product-card">
                <div class="card-media">
                  {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class="card-content">
                  <h3 class="card-title"><a href="#">Jacquard Silhouette {{ i }}</a></h3>
                  <div class="card-price-row">
                    <span class="price-now">₹899</span>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- Grand Master Vault Collector Banner -->
    {%- if section.settings.vault_product != blank -%}
      {%- assign grand_vault = section.settings.vault_product -%}
      <div class="vault-master-banner">
        <div class="vault-master-thumb">
          {%- if grand_vault.featured_media -%}
            {{ grand_vault.featured_media | image_url: width: 800 | image_tag: 
              class: 'vault-master-img', 
              alt: grand_vault.title | escape 
            }}
          {%- else -%}
            <img src="{{ 'product-master-box.jpg' | asset_url }}" alt="{{ grand_vault.title | escape }}" class="vault-master-img" width="400" height="300" loading="lazy">
          {%- endif -%}
          <span class="vault-master-badge">Ultimate 8-Piece Vault</span>
        </div>

        <div class="vault-master-content">
          <div class="vault-master-header">
            <div>
              <span class="vault-tag">ATELIER MASTER COLLECTION // 8 ARCHIVAL WEAVES</span>
              <h3><a href="{{ grand_vault.url }}">{{ grand_vault.title }}</a></h3>
            </div>
            <div class="vault-master-pricing">
              <span class="price-now">{{ grand_vault.price | money }}</span>
              {%- if grand_vault.compare_at_price > grand_vault.price -%}
                <span class="price-was">{{ grand_vault.compare_at_price | money }}</span>
              {%- endif -%}
            </div>
          </div>

          <p class="vault-master-desc">{{ grand_vault.description | strip_html | truncatewords: 40 }}</p>

          <div class="vault-master-perks">
            <div class="master-perk-pill">
              {% render 'icon-shield-check' %}
              <span>8 Complete Pairs (Silk, Waxed, Rope, 3M, Velvet, Jacquard)</span>
            </div>
            <div class="master-perk-pill">
              {% render 'icon-check' %}
              <span>16 CNC Solid Metal Aglet Kit (Gold, Silver, Gunmetal)</span>
            </div>
            <div class="master-perk-pill">
              {% render 'icon-sparkles' %}
              <span>Steel Threading Key &amp; 80g Organic Beeswax Puck</span>
            </div>
          </div>

          <div class="vault-master-actions">
            <button 
              type="button" 
              class="btn-gold" 
              data-add-to-cart 
              data-variant-id="{{ grand_vault.selected_or_first_available_variant.id }}"
            >
              {% render 'icon-shopping-bag' %}
              <span>Secure The 8-Piece Archive Chest</span>
            </button>
            <a href="{{ grand_vault.url }}" class="btn-secondary">
              {% render 'icon-eye' %}
              <span>Inspect Vault Details</span>
            </a>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Design Lab Capsule",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "ALCE DESIGN LAB // S'25 CAPSULE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Artisanal Jacquard & Tapestry Series"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Beyond standard solids. Four high-density Jacquard loom tapestries featuring custom-coated enamel aglets, presented in our signature textured collector's box."
    },
    {
      "type": "image_picker",
      "id": "box_image",
      "label": "Capsule Presentation Box Image"
    },
    {
      "type": "product",
      "id": "box_product",
      "label": "4-Pack Capsule Box Product"
    },
    {
      "type": "collection",
      "id": "capsule_collection",
      "label": "Capsule Laces Collection (Shows first 4 items in 2x2 grid)"
    },
    {
      "type": "product",
      "id": "vault_product",
      "label": "Grand Master Archive Vault Product (8-Piece Chest)"
    }
  ],
  "presets": [
    {
      "name": "Design Lab Capsule"
    }
  ]
}
{% endschema %}

{%- comment -%}
  LACEYAAN Atelier High-Fashion Editorial Product Detail Section (Bluorng Luxury Aesthetic)
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="main-product-section bluorng-product-page" data-section-id="{{ section.id }}" data-section-type="main-product" {{ section.shopify_attributes }}>
  <div class="container bluorng-container">
    <div class="bluorng-product-layout">
      <!-- Left: Bluorng Multi-Image Editorial Gallery with Side Thumbnails -->
      <div class="bluorng-gallery-col" id="BluorngGalleryCol">
        <!-- Floating Controls / Counter on Gallery -->
        <div class="gallery-floating-bar">
          <span class="gallery-counter-pill" id="GalleryCounterPill">1 / {{ product.media.size | default: 1 }}</span>
          <button type="button" class="gallery-zoom-trigger" id="GalleryZoomTrigger" aria-label="Open Fullscreen Lightbox">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          </button>
        </div>

        <div class="gallery-layout-with-thumbs">
          <!-- Small Thumbnail Pieces By Side of the Image ("i should be able to see them in small piece by side of the image") -->
          {%- if product.media.size > 1 -%}
            <aside class="gallery-side-thumbs" id="ProductGalleryThumbs" aria-label="Product thumbnails">
              {%- for media in product.media -%}
                <button 
                  type="button" 
                  class="gallery-thumb-btn thumb-dock-pill{% if forloop.first %} active{% endif %}" 
                  data-thumb-index="{{ forloop.index0 }}" 
                  data-media-url="{{ media | image_url: width: 1400 }}"
                  aria-label="View product image {{ forloop.index }}"
                >
                  <img 
                    src="{{ media | image_url: width: 220, height: 220, crop: 'center' }}" 
                    alt="{{ media.alt | default: product.title | escape }}" 
                    loading="lazy" 
                    width="110" 
                    height="110"
                    class="thumb-img"
                  >
                </button>
              {%- endfor -%}
            </aside>
          {%- endif -%}

          <!-- Main Gallery Stage (Editorial Grid & Hero Photo with arrows) -->
          <div class="gallery-main-stage">
            <div class="bluorng-editorial-grid" id="BluorngEditorialGrid" data-media-count="{{ product.media.size }}">
              {%- if product.media.size > 0 -%}
                {%- for media in product.media -%}
                  <div 
                    class="gallery-item-card{% if forloop.first %} is-hero-item active{% endif %}" 
                    data-media-index="{{ forloop.index0 }}"
                    data-full-url="{{ media | image_url: width: 2000 }}"
                  >
                    {{ media | image_url: width: 1400 | image_tag: 
                      class: 'gallery-editorial-img',
                      id: forloop.first ? 'ProductMainImage' : '',
                      loading: forloop.first ? 'eager' : 'lazy',
                      widths: '600, 800, 1000, 1400',
                      alt: media.alt | default: product.title | escape 
                    }}
                    {% if forloop.first %}
                      <!-- Hero image: left/right arrows for navigation -->
                      <button type="button" class="hero-nav-arrow hero-prev-arrow" id="HeroPrevArrow" aria-label="Previous photo">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                      </button>
                      <button type="button" class="hero-nav-arrow hero-next-arrow" id="HeroNextArrow" aria-label="Next photo">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </button>
                    {% endif %}
                    <button type="button" class="card-expand-btn" aria-label="View photo {{ forloop.index }} in high resolution">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
                    </button>
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div class="gallery-item-card is-hero-item active" data-media-index="0" data-full-url="{% if product.featured_media != blank %}{{ product.featured_media | image_url: width: 2000 }}{% endif %}">
                  {%- if product.featured_media != blank -%}
                    {{ product.featured_media | image_url: width: 1400 | image_tag: 
                      class: 'gallery-editorial-img', 
                      id: 'ProductMainImage',
                      loading: 'eager',
                      alt: product.title | escape 
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

            <!-- Mobile Carousel Navigation Controls (Arrows + Dots) -->
            <div class="gallery-carousel-nav" id="GalleryCarouselNav">
              <button type="button" class="carousel-arrow-btn prev-btn" id="GalleryPrevBtn" aria-label="Previous photo">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
              </button>
              
              <div class="carousel-dots-wrap" id="GalleryDotsWrap">
                {%- for media in product.media -%}
                  <button type="button" class="carousel-dot{% if forloop.first %} active{% endif %}" data-dot-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
                {%- endfor -%}
              </div>

              <button type="button" class="carousel-arrow-btn next-btn" id="GalleryNextBtn" aria-label="Next photo">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Bluorng Floating White Purchasing Card -->
      <div class="bluorng-card-col">
        <div class="bluorng-buy-card">
          <!-- Card Header: Title & Wishlist Bookmark -->
          <div class="card-title-row">
            <h1 class="card-product-title">{{ product.title }}</h1>
            <button type="button" class="btn-wishlist-bookmark" id="WishlistBookmarkBtn" aria-label="Save to Wishlist" title="Save to Wishlist">
              <svg class="bookmark-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
            </button>
          </div>

          <!-- Price & Stock Status -->
          <div class="card-price-row">
            <span class="card-price-now" data-product-price>{{ current_variant.price | money }}</span>
            <span class="card-price-was" data-compare-price{% unless current_variant.compare_at_price > current_variant.price %} style="display: none;"{% endunless %}>
              {{ current_variant.compare_at_price | money }}
            </span>
            <span class="card-stock-status">
              <span class="stock-dot"></span>
              <span data-stock-text>
                {%- if current_variant.available -%}In Stock &mdash; Ready to Dispatch{%- else -%}Sold Out{%- endif -%}
              </span>
            </span>
          </div>

          <!-- Native Shopify Form -->
          {%- form 'product', product, id: 'product-form-installment', class: 'bluorng-native-form' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" id="selected-variant-id">
            <input type="hidden" name="quantity" value="1" id="product-quantity-input">

            <!-- Size / Length Selection -->
            {%- unless product.has_only_default_variant -%}
              <div class="card-variants-section">
                {%- for option in product.options_with_values -%}
                  <div class="variant-option-block" data-option-group data-option-index="{{ forloop.index0 }}">
                    <div class="variant-label-row">
                      <span class="variant-name-label">
                        {{ option.name }}: <strong class="active-val" data-selected-option-label="{{ option.name | escape }}">{{ option.selected_value }}</strong>
                      </span>
                      <button type="button" class="btn-size-guide-pill" id="OpenSizeGuideBtn">Size Guide</button>
                    </div>

                    <div class="variant-pills-row">
                      {%- for value in option.values -%}
                        <label class="variant-size-pill{% if option.selected_value == value %} is-selected{% endif %}">
                          <input 
                            type="radio" 
                            name="options[{{ option.name | escape }}]" 
                            value="{{ value | escape }}"
                            {% if option.selected_value == value %}checked="checked"{% endif %}
                            class="visually-hidden option-radio-input"
                            data-option-input
                            data-option-position="{{ option.position }}"
                          >
                          <span class="pill-text">{{ value }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="card-variants-section single-variant-guide">
                <div class="variant-label-row">
                  <span class="variant-name-label">Standard Atelier Universal Fit</span>
                  <button type="button" class="btn-size-guide-pill" id="OpenSizeGuideBtn">Size Guide</button>
                </div>
              </div>
            {%- endunless -%}

            <!-- Actions Row: Add to Bag (White) + Buy Now (Black) -->
            <div class="card-actions-row">
              <button 
                type="submit" 
                name="add" 
                class="btn-bluorng-bag" 
                id="AddToCart-{{ section.id }}"
                data-add-to-cart-button
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span id="AddToCartText-{{ section.id }}" data-add-to-cart-text>
                  {%- if current_variant.available -%}ADD TO BAG{%- else -%}SOLD OUT{%- endif -%}
                </span>
              </button>

              <button 
                type="button" 
                class="btn-bluorng-buy" 
                id="BuyNow-{{ section.id }}"
                data-direct-buy-now
                data-variant-id="{{ current_variant.id }}"
                data-product-handle="{{ product.handle }}"
                {% unless current_variant.available %}disabled style="display:none;"{% endunless %}
              >
                BUY NOW
              </button>
            </div>

            {%- if section.settings.show_dynamic_checkout -%}
              <div class="dynamic-payment-buttons">
                {{ form | payment_button }}
              </div>
            {%- endif -%}
          {%- endform -%}

          <!-- 1. Product Description (Directly below Buy Now in the red area) -->
          <div class="product-description-block" id="ProductDescriptionBlock">
            <div class="desc-heading-wrap">
              <span class="desc-heading">Product Description</span>
            </div>
            {%- if product.description != blank -%}
              <div class="tab-description-rte rte product-description-body">
                {{ product.description }}
              </div>
            {%- else -%}
              <div class="tab-description-rte rte product-description-body">
                <p>Triple-braided on high-tension Japanese shuttle looms. Woven from 100% long-staple combed cotton, finished with solid CNC-milled brass tips engraved with the LACEYAAN hallmark.</p>
                <p><strong>Type:</strong> Premium Lace</p>
                <p><strong>Material:</strong> 100% Long-Staple Combed Cotton</p>
                <p><strong>Aglet:</strong> Solid CNC-Milled Metal</p>
              </div>
            {%- endif -%}

            <div class="luxury-perks-list">
              <div class="perk-item"><span class="perk-bullet">&bull;</span> Packed within 24 hours.</div>
              <div class="perk-item"><span class="perk-bullet">&bull;</span> Free delivery pan-India.</div>
              <div class="perk-item"><span class="perk-bullet">&bull;</span> Dispatches next day.</div>
            </div>
          </div>

          <!-- 2. Pincode Delivery Checker (Placed after and below the product description) -->
          <div class="product-pincode-wrap" id="ProductPincodeWrap">
            {% render 'pincode-checker', context: 'product' %}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Fullscreen Lightbox Image Gallery Modal ("i should be able to go through all the pictures") -->
  <div class="gallery-lightbox-modal" id="GalleryLightboxModal" aria-hidden="true">
    <div class="lightbox-overlay" id="LightboxOverlay"></div>
    <div class="lightbox-stage">
      <button type="button" class="lightbox-close-btn" id="LightboxCloseBtn" aria-label="Close Lightbox">&times;</button>
      
      <div class="lightbox-counter-bar">
        <span class="lightbox-counter" id="LightboxCounter">1 / 1</span>
        <span class="lightbox-title">{{ product.title }}</span>
      </div>

      <div class="lightbox-image-wrap">
        <button type="button" class="lightbox-arrow-btn prev-arrow" id="LightboxPrevBtn" aria-label="Previous image">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <img src="" alt="{{ product.title | escape }}" class="lightbox-active-img" id="LightboxActiveImg">
        <button type="button" class="lightbox-arrow-btn next-arrow" id="LightboxNextBtn" aria-label="Next image">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>

      <div class="lightbox-thumbs-strip" id="LightboxThumbsStrip"></div>
    </div>
  </div>

  <!-- Interactive Size Guide Modal -->
  <div class="size-guide-modal" id="SizeGuideModal" aria-hidden="true">
    <div class="size-guide-backdrop" id="SizeGuideBackdrop"></div>
    <div class="size-guide-dialog">
      <div class="size-guide-header">
        <h3 class="size-guide-title">Shoelace Length &amp; Fit Guide</h3>
        <button type="button" class="size-guide-close" id="SizeGuideCloseBtn" aria-label="Close Size Guide">&times;</button>
      </div>
      <div class="size-guide-body">
        <p class="size-guide-sub">Use your shoe's eyelet count to select the perfect drape:</p>
        <div class="size-guide-table-wrap">
          <table class="size-guide-table">
            <thead>
              <tr>
                <th>Pairs of Eyelets</th>
                <th>Recommended Length</th>
                <th>Sneaker Silhouettes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>4 Eyelets</strong></td>
                <td>90cm (36")</td>
                <td>Low-top casuals, dress shoes</td>
              </tr>
              <tr>
                <td><strong>5 &ndash; 6 Eyelets</strong></td>
                <td>120cm (47")</td>
                <td>Air Force 1 Low, Dunk Low, Sambas</td>
              </tr>
              <tr>
                <td><strong>6 &ndash; 7 Eyelets</strong></td>
                <td>140cm (55")</td>
                <td>Jordan 1 Mid, New Balance 550, Forum</td>
              </tr>
              <tr>
                <td><strong>7 &ndash; 8 Eyelets</strong></td>
                <td>160cm (63")</td>
                <td>Jordan 1 High, Dunk High, Blazers</td>
              </tr>
              <tr>
                <td><strong>8+ Eyelets</strong></td>
                <td>180cm (71")</td>
                <td>Boots, high basketball collars</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Sticky Add-to-Bag Bar -->
  <div class="mobile-sticky-buy-bar" id="mobile-sticky-buy-bar" aria-hidden="true">
    <div class="sticky-buy-bar-inner">
      <div class="sticky-product-info">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 100 | image_tag: 
            class: 'sticky-thumb-img', 
            alt: product.title | escape 
          }}
        {%- endif -%}
        <div class="sticky-text-meta">
          <span class="sticky-title">{{ product.title | truncate: 24 }}</span>
          <span class="sticky-price" id="StickyBarPrice">{{ current_variant.price | money }}</span>
        </div>
      </div>
      <button 
        type="button" 
        class="sticky-add-btn" 
        id="StickyAddToCartBtn"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        {%- if current_variant.available -%}
          ADD TO BAG
        {%- else -%}
          SOLD OUT
        {%- endif -%}
      </button>
    </div>
  </div>

  <!-- Product JSON and Variants data for script variant switching -->
  <script type="application/json" id="ProductJson-{{ section.id }}">
    {{ product | json }}
  </script>
  <script type="application/json" data-product-variants-json>
    {{ product.variants | json }}
  </script>
</section>

{% schema %}
{
  "name": "Product Details",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button (Buy It Now)",
      "default": true
    }
  ]
}
{% endschema %}

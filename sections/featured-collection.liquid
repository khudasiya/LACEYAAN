{%- comment -%}
  Best Sellers / Featured Collection Section
{%- endcomment -%}

<section class="featured-collection-section section-padding" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section-header text-center">
      {%- if section.settings.badge != blank -%}
        <span class="badge badge-gold">{{ section.settings.badge }}</span>
      {%- endif -%}
      <h2 class="editorial-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- assign target_collection = collections[section.settings.collection] | default: collections.all -%}

    <div class="product-grid-layout grid-cols-{{ section.settings.columns_desktop }}">
      {%- if section.settings.product_list != blank and section.settings.product_list.count > 0 -%}
        {%- for product in section.settings.product_list limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- elsif target_collection != blank and target_collection.products_count > 0 -%}
        {%- for product in target_collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- assign fallback_laces = 'product-rope.jpg|10mm Chunky Braided Rope Laces|₹899|Raw Ecru Cotton,product-waxed.jpg|Japanese Waxed Flat Sneaker Laces|₹799|Matte Noir Wax,product-reflective.jpg|Nocturnal 3M Reflective Rope Laces|₹999|Reflective Silver,product-vintage.jpg|1985 Vintage Distressed Flat Laces|₹799|Aged Sail Fade,product-leather.jpg|Italian Lambskin Leather Laces|₹1,299|Solid Brass Tips,product-aglets.jpg|CNC Laser-Engraved Brass Aglets Kit|₹699|Gold Aglet Set,product-carbon.jpg|Carbon Weave Technical Laces|₹899|Ballistic Weave,product-duotone.jpg|Duotone Split Weave Laces|₹899|Dual Accent' | split: ',' -%}
        {%- for lace_str in fallback_laces limit: section.settings.products_to_show -%}
          {%- assign lace_parts = lace_str | split: '|' -%}
          <div class="product-card">
            <div class="card-media">
              <img src="{{ lace_parts[0] | asset_url }}" alt="{{ lace_parts[1] }}" class="card-img-primary" width="400" height="400" loading="lazy">
            </div>
            <div class="card-content">
              <span class="card-vendor">{{ lace_parts[3] }}</span>
              <h3 class="card-title"><a href="{{ routes.all_products_collection_url }}">{{ lace_parts[1] }}</a></h3>
              <div class="card-price-row">
                <span class="price-now">{{ lace_parts[2] }}</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and target_collection.url != blank -%}
      <div class="section-footer-cta text-center">
        <a href="{{ target_collection.url }}" class="btn-primary">
          <span>{{ section.settings.view_all_label | default: 'Explore All Atelier Weaves' }}</span>
          &rarr;
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "CURATED ATELIER FAVORITES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers & Signature Weaves"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "From our flagship Japanese waxed cotton flats to 10mm chunky rope and nocturnal 3M reflective weaves. Handcrafted with solid brass aglets."
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Select Specific Products (Optional)",
      "limit": 16
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Or Select a Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button Label",
      "default": "Explore All Atelier Weaves"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}

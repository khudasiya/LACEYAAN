{%- comment -%}
  Best Sellers / Featured Collection Section
{%- endcomment -%}

<section class="featured-collection-section section-padding" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section-header text-center">
      {%- if section.settings.badge != blank -%}
        <span class="badge badge-gold">{{ section.settings.badge }}</span>
      {%- endif -%}
      <h2 class="editorial-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- assign target_collection = collections[section.settings.collection] | default: collections.all -%}

    <div class="product-grid-layout grid-cols-{{ section.settings.columns_desktop }}">
      {%- if target_collection != blank and target_collection.products_count > 0 -%}
        {%- for product in target_collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <div class="product-card">
            <div class="card-media">
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="card-content">
              <h3 class="card-title"><a href="#">Bespoke Woven Lace {{ i }}</a></h3>
              <div class="card-price-row">
                <span class="price-now">₹899</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and target_collection.url != blank -%}
      <div class="section-footer-cta text-center">
        <a href="{{ target_collection.url }}" class="btn-primary">
          <span>{{ section.settings.view_all_label | default: 'Explore All Atelier Weaves' }}</span>
          &rarr;
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "CURATED ATELIER FAVORITES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers & Signature Weaves"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "From our flagship Japanese waxed cotton flats to 10mm chunky rope and nocturnal 3M reflective weaves. Handcrafted with solid brass aglets."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button Label",
      "default": "Explore All Atelier Weaves"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}

<section class="ly-staggered-laces-section" id="SpecimenVault">
  <div class="ly-staggered-container">
    
    <!-- Minimalist Section Header Matching Screenshot 2 -->
    <div class="ly-staggered-header">
      <span class="ly-staggered-eyebrow">// DROP 01 ARCHIVE</span>
      <h2 class="ly-staggered-title">{{ section.settings.heading | default: 'THE PALETTE PREVIEW' }}</h2>
    </div>

    <!-- Alternating Staggered Layout Matching Screenshots 2, 3, 5: 1 (Left) -> 2 (Right) -> 3 (Left) -> 4 (Right) -->
    <div class="ly-staggered-track">

      <!-- 01 Leopard Jacquard (Aligned Left) -->
      <div class="ly-stagger-item ly-stagger-left" data-index="1">
        <div class="ly-lace-circle-frame">
          <img src="{{ 'lace-jaguar.jpg' | asset_url }}" alt="Leopard Jacquard Lace" class="ly-lace-round-img" loading="lazy" width="500" height="500">
        </div>
        <div class="ly-lace-caption">
          <span class="ly-lace-index">1.</span>
          <h3 class="ly-lace-title">LEOPARD JACQUARD</h3>
        </div>
      </div>

      <!-- 02 Blush Combed Cotton (Staggered Right) -->
      <div class="ly-stagger-item ly-stagger-right" data-index="2">
        <div class="ly-lace-circle-frame">
          <img src="{{ 'lace-pink.jpg' | asset_url }}" alt="Blush Pink Combed Cotton Lace" class="ly-lace-round-img" loading="lazy" width="500" height="500">
        </div>
        <div class="ly-lace-caption">
          <span class="ly-lace-index">2.</span>
          <h3 class="ly-lace-title">BLUSH COMBED COTTON</h3>
        </div>
      </div>

      <!-- 03 Canary Streetwear (Aligned Left) -->
      <div class="ly-stagger-item ly-stagger-left" data-index="3">
        <div class="ly-lace-circle-frame">
          <img src="{{ 'lace-yellow.jpg' | asset_url }}" alt="Canary Yellow Flat Braid Lace" class="ly-lace-round-img" loading="lazy" width="500" height="500">
        </div>
        <div class="ly-lace-caption">
          <span class="ly-lace-index">3.</span>
          <h3 class="ly-lace-title">CANARY STREETWEAR</h3>
        </div>
      </div>

      <!-- 04 Strontium Phosphor (Staggered Right with Dedicated Glow Option) -->
      <div class="ly-stagger-item ly-stagger-right ly-stagger-glow" data-index="4" id="lyGlowNode">
        <div class="ly-lace-circle-frame ly-glow-circle-frame" id="lyGlowCircleFrame">
          <img src="{{ 'lace-glow.jpg' | asset_url }}" alt="Strontium Phosphor Glow in the Dark Lace" class="ly-lace-round-img ly-glow-round-img" id="lyGlowRoundImg" loading="lazy" width="500" height="500">
          <div class="ly-glow-aura" id="lyGlowAura"></div>
        </div>

        <div class="ly-lace-caption">
          <span class="ly-lace-index">4.</span>
          <h3 class="ly-lace-title">STRONTIUM PHOSPHOR</h3>
          
          <!-- In front of the glow lace: Dedicated option to glow -->
          <div class="ly-lace-glow-action">
            <button type="button" class="ly-lace-glow-btn" id="lyLaceGlowBtn" aria-label="Toggle Glow on this lace" aria-pressed="false">
              <span class="ly-glow-sparkle">✦</span>
              <span class="ly-glow-btn-label">ACTIVATE GLOW</span>
            </button>
            <span class="ly-glow-subhint">Photoluminescent test &bull; Tap to illuminate</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Palette Preview",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "THE PALETTE PREVIEW"
    }
  ]
}
{% endschema %}

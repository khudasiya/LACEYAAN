<section class="ly-staggered-laces-section" id="SpecimenVault">
  <div class="ly-staggered-container">
    
    <!-- Minimalist Section Header -->
    <div class="ly-staggered-header">
      <span class="ly-staggered-eyebrow">// DROP 01 ARCHIVE</span>
      <h2 class="ly-staggered-title">{{ section.settings.heading | default: 'SIGNATURE WEAVES' }}</h2>
    </div>

    <!-- Alternating Staggered Layout: 1 (Left) -> 2 (Right) -> 3 (Left) -> 4 (Right) -->
    <div class="ly-staggered-track" id="lyLaceTrack">

      <!-- 01 Leopard / Jaguar (Aligned Left -> Expands Right) -->
      <div class="ly-stagger-item ly-stagger-left" data-lace-id="leopard" id="lyLaceItem1" tabindex="0" role="button" aria-expanded="false" aria-label="Leopard Jacquard lace - hover or tap to reveal full lace">
        <div class="ly-lace-stage-wrap">
          <div class="ly-lace-stage" id="lyStage1">
            <!-- Compact Coiled Visual -->
            <img src="{{ 'lace-jaguar.jpg' | asset_url }}" alt="Leopard Jacquard Coiled Lace" class="ly-stage-coil" loading="eager" decoding="async" width="500" height="500">
            <!-- Full Horizontal Photo of Unrolled Lace (Eager loaded for instant first click) -->
            <img src="{{ 'lace-jaguar-full.jpg' | asset_url }}" alt="Leopard Jacquard Full Unrolled Lace" class="ly-stage-full" loading="eager" decoding="async" width="1376" height="768">
          </div>
        </div>
        <div class="ly-lace-caption">
          <span class="ly-lace-index">1.</span>
          <h3 class="ly-lace-title">LEOPARD JACQUARD</h3>
        </div>
      </div>

      <!-- 02 Blush Pink (Staggered Right -> Expands Left) -->
      <div class="ly-stagger-item ly-stagger-right" data-lace-id="blush" id="lyLaceItem2" tabindex="0" role="button" aria-expanded="false" aria-label="Blush Combed Cotton lace - hover or tap to reveal full lace">
        <div class="ly-lace-caption">
          <span class="ly-lace-index">2.</span>
          <h3 class="ly-lace-title">BLUSH COMBED COTTON</h3>
        </div>
        <div class="ly-lace-stage-wrap">
          <div class="ly-lace-stage" id="lyStage2">
            <!-- Compact Coiled Visual -->
            <img src="{{ 'lace-pink.jpg' | asset_url }}" alt="Blush Combed Cotton Coiled Lace" class="ly-stage-coil" loading="eager" decoding="async" width="500" height="500">
            <!-- Full Horizontal Photo of Unrolled Lace (Eager loaded for instant first click) -->
            <img src="{{ 'lace-pink-full.jpg' | asset_url }}" alt="Blush Combed Cotton Full Unrolled Lace" class="ly-stage-full" loading="eager" decoding="async" width="1376" height="768">
          </div>
        </div>
      </div>

      <!-- 03 Canary Streetwear Yellow (Aligned Left -> Expands Right) -->
      <div class="ly-stagger-item ly-stagger-left" data-lace-id="canary" id="lyLaceItem3" tabindex="0" role="button" aria-expanded="false" aria-label="Canary Streetwear lace - hover or tap to reveal full lace">
        <div class="ly-lace-stage-wrap">
          <div class="ly-lace-stage" id="lyStage3">
            <!-- Compact Coiled Visual -->
            <img src="{{ 'lace-yellow.jpg' | asset_url }}" alt="Canary Streetwear Coiled Lace" class="ly-stage-coil" loading="eager" decoding="async" width="500" height="500">
            <!-- Full Horizontal Photo of Unrolled Lace (Eager loaded for instant first click) -->
            <img src="{{ 'lace-yellow-full.jpg' | asset_url }}" alt="Canary Streetwear Full Unrolled Lace" class="ly-stage-full" loading="eager" decoding="async" width="1376" height="768">
          </div>
        </div>
        <div class="ly-lace-caption">
          <span class="ly-lace-index">3.</span>
          <h3 class="ly-lace-title">CANARY STREETWEAR</h3>
        </div>
      </div>

      <!-- 04 Strontium Glow in the Dark (Staggered Right -> Expands Left) -->
      <div class="ly-stagger-item ly-stagger-right ly-stagger-glow" data-lace-id="strontium" id="lyGlowNode" tabindex="0" role="button" aria-expanded="false" aria-label="Strontium Phosphor Glow lace - hover or tap to reveal full lace">
        <div class="ly-lace-caption">
          <span class="ly-lace-index">4.</span>
          <h3 class="ly-lace-title">STRONTIUM PHOSPHOR</h3>
          
          <!-- In front of the glow lace: Dedicated option to glow (Lace only, not website) -->
          <div class="ly-lace-glow-action">
            <button type="button" class="ly-lace-glow-btn" id="lyLaceGlowBtn" aria-label="Toggle Glow on this lace" aria-pressed="false">
              <span class="ly-glow-sparkle">✦</span>
              <span class="ly-glow-btn-label">ACTIVATE GLOW</span>
            </button>
            <span class="ly-glow-subhint">Photoluminescent test &bull; Tap to illuminate</span>
          </div>
        </div>

        <div class="ly-lace-stage-wrap">
          <div class="ly-lace-stage ly-glow-circle-frame" id="lyGlowCircleFrame">
            <!-- Compact Coiled Visual -->
            <img src="{{ 'lace-glow.jpg' | asset_url }}" alt="Strontium Phosphor Glow Coiled Lace" class="ly-stage-coil ly-glow-round-img" id="lyGlowRoundImg" loading="eager" decoding="async" width="500" height="500">
            <!-- Full Horizontal Photo of Unrolled Lace (Eager loaded for instant first click) -->
            <img src="{{ 'lace-glow-full.jpg' | asset_url }}" alt="Strontium Phosphor Full Unrolled Lace" class="ly-stage-full ly-glow-full-img" id="lyGlowFullImg" loading="eager" decoding="async" width="1376" height="768">
            <div class="ly-glow-aura" id="lyGlowAura"></div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Signature Laces",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "SIGNATURE WEAVES"
    }
  ]
}
{% endschema %}

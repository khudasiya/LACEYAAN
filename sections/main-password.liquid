{%- comment -%}
  LACEYAAN Luxury Coming Soon / Password Section
  Features:
  - Real-time countdown timer to September 24, 2026
  - VIP Drop List early-access newsletter capture
  - Discreet store-owner password login modal
  - High-streetwear dark aesthetic with animated shoelace backdrop
{%- endcomment -%}

<section class="password-hero-section" {{ section.shopify_attributes }}>
  <div class="password-container">
    <!-- Top Navigation Bar -->
    <header class="password-top-bar">
      <div class="password-logo-lockup">
        <a href="{{ routes.root_url }}" class="password-brand-link" aria-label="LACEYAAN Home">
          <div class="brand-lockup">
            <img 
              src="{{ 'logo-icon.png' | asset_url }}" 
              alt="LACEYAAN Emblem" 
              class="brand-icon-mark"
              width="36"
              height="40"
              loading="eager"
            >
            <span class="logo-title">LACEYAAN</span>
          </div>
          <span class="logo-subtitle">CRAFTED IN INDIA</span>
        </a>
      </div>

      <button 
        type="button" 
        class="password-login-trigger" 
        id="open-password-modal" 
        aria-haspopup="dialog" 
        aria-controls="password-login-modal"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>Enter with Password</span>
      </button>
    </header>

    <!-- Main Hero Content -->
    <div class="password-content text-center">
      <div class="password-badge-wrap">
        <span class="badge badge-gold">{{ section.settings.badge | default: 'DROPPING SEPTEMBER 24' }}</span>
      </div>

      <h1 class="password-heading">{{ section.settings.heading | default: 'The Next Standard in Footwear Craft.' }}</h1>

      <p class="password-subtitle">
        {{ section.settings.subtext | default: 'Factory laces were made to save margins. laceyaan laces are engineered to honor design. Slow shuttle-loomed weaves, 10mm chunky braids, 3M nocturnal reflective cords, and solid CNC naval brass aglets.' }}
      </p>

      <!-- Live Countdown Timer -->
      <div class="countdown-container" id="launch-countdown" data-launch-date="{{ section.settings.launch_date | default: '2026-09-24T00:00:00+05:30' }}">
        <div class="countdown-unit">
          <span class="countdown-number" id="countdown-days">00</span>
          <span class="countdown-label">Days</span>
        </div>
        <span class="countdown-divider">:</span>
        <div class="countdown-unit">
          <span class="countdown-number" id="countdown-hours">00</span>
          <span class="countdown-label">Hours</span>
        </div>
        <span class="countdown-divider">:</span>
        <div class="countdown-unit">
          <span class="countdown-number" id="countdown-minutes">00</span>
          <span class="countdown-label">Mins</span>
        </div>
        <span class="countdown-divider">:</span>
        <div class="countdown-unit">
          <span class="countdown-number" id="countdown-seconds">00</span>
          <span class="countdown-label">Secs</span>
        </div>
      </div>

      <!-- VIP Early Access Drop List -->
      <div class="password-signup-box">
        <h2 class="signup-title">{{ section.settings.newsletter_title | default: 'Get Priority Access On Launch Day' }}</h2>
        <p class="signup-desc">{{ section.settings.newsletter_subtext | default: 'Be the first in rotation. Early access link and limited edition aglet kit reservation drop to your inbox.' }}</p>

        {%- form 'customer', id: 'PasswordCustomerForm', class: 'password-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,launch_waitlist">
          {%- if form.posted_successfully? -%}
            <div class="password-alert-success">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>You are on the VIP priority drop list. Expect your private link on September 24.</span>
            </div>
          {%- else -%}
            <div class="password-input-wrap">
              <input
                type="email"
                name="contact[email]"
                id="PasswordCustomerEmail"
                class="password-email-input"
                placeholder="ENTER YOUR EMAIL FOR EARLY ACCESS"
                aria-label="Email address for launch notification"
                value="{{ form.email }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                required
              >
              <button type="submit" class="password-submit-btn" aria-label="Join early access drop list">
                <span>NOTIFY ME</span>
                &rarr;
              </button>
            </div>

            {%- if form.errors -%}
              <p class="password-alert-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>

      <!-- Teaser Features -->
      <div class="password-pillars-grid">
        <div class="password-pillar">
          <span class="pillar-stat">3.8MM</span>
          <h4>Universal Eyelet Fit</h4>
          <p>Milled to slide effortlessly into Jordan 1, Sambas, Dunks, and boots.</p>
        </div>
        <div class="password-pillar">
          <span class="pillar-stat">100%</span>
          <h4>Solid Naval Brass Aglets</h4>
          <p>Weighted metal tips laser-engraved with the signature LACEYAAN hallmark.</p>
        </div>
        <div class="password-pillar">
          <span class="pillar-stat">20,000</span>
          <h4>Cycle Tensile Durability</h4>
          <p>Japanese slow-shuttle combed cotton infused with organic beeswax.</p>
        </div>
      </div>
    </div>

    <!-- Minimalist Footer -->
    <footer class="password-footer">
      <div class="password-social-row">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" class="password-social-link" aria-label="Follow on Instagram">
            {% render 'icon-instagram' %}
            <span>@laceyaan_</span>
          </a>
        {%- endif -%}
        {%- if settings.social_spotify_link != blank -%}
          <a href="{{ settings.social_spotify_link }}" target="_blank" rel="noopener noreferrer" class="password-social-link" aria-label="Stream on Spotify">
            {% render 'icon-spotify' %}
            <span>Spotify Soundscape</span>
          </a>
        {%- endif -%}
      </div>

      <p class="password-copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All Rights Reserved.</p>
    </footer>
  </div>

  <!-- Store Owner / VIP Password Login Modal -->
  <div id="password-modal-overlay" class="password-modal-overlay" aria-hidden="true"></div>

  <div id="password-login-modal" class="password-login-modal" role="dialog" aria-modal="true" aria-labelledby="password-modal-heading" aria-hidden="true">
    <button type="button" class="modal-close-btn" id="close-password-modal" aria-label="Close password modal">
      {% render 'icon-close' %}
    </button>

    <div class="password-modal-inner">
      <h3 id="password-modal-heading">Storefront Access</h3>
      <p class="password-modal-subtext">Enter the store password to view the private preview or editorial catalog.</p>

      {%- form 'storefront_password', class: 'storefront-password-form' -%}
        {%- if form.errors -%}
          <div class="password-alert-error">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="password-modal-input-group">
          <input
            type="password"
            name="password"
            id="StorefrontPasswordInput"
            class="password-modal-input"
            placeholder="ENTER STORE PASSWORD"
            autocomplete="current-password"
            required
          >
          <button type="submit" class="btn-primary">
            <span>ENTER STORE</span>
          </button>
        </div>
      {%- endform -%}

      <div class="password-owner-prompt">
        <span>Are you the store owner?</span>
        <a href="/admin" class="password-admin-link">Log in to Shopify Admin &rarr;</a>
      </div>
    </div>
  </div>
</section>

<!-- Countdown & Modal JavaScript -->
<script>
  (function() {
    // 1. Live Countdown Timer
    const countdownEl = document.getElementById('launch-countdown');
    if (countdownEl) {
      const launchStr = countdownEl.dataset.launchDate || '2026-09-24T00:00:00+05:30';
      const launchTime = new Date(launchStr).getTime();

      const daysEl = document.getElementById('countdown-days');
      const hoursEl = document.getElementById('countdown-hours');
      const minsEl = document.getElementById('countdown-minutes');
      const secsEl = document.getElementById('countdown-seconds');

      function updateCountdown() {
        const now = new Date().getTime();
        const diff = launchTime - now;

        if (diff <= 0) {
          if (daysEl) daysEl.textContent = '00';
          if (hoursEl) hoursEl.textContent = '00';
          if (minsEl) minsEl.textContent = '00';
          if (secsEl) secsEl.textContent = '00';
          return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minsEl) minsEl.textContent = String(minutes).padStart(2, '0');
        if (secsEl) secsEl.textContent = String(seconds).padStart(2, '0');
      }

      updateCountdown();
      setInterval(updateCountdown, 1000);
    }

    // 2. Password Login Modal
    const openBtn = document.getElementById('open-password-modal');
    const closeBtn = document.getElementById('close-password-modal');
    const modal = document.getElementById('password-login-modal');
    const overlay = document.getElementById('password-modal-overlay');
    const passwordInput = document.getElementById('StorefrontPasswordInput');

    function openModal() {
      if (!modal || !overlay) return;
      modal.classList.add('active', 'is-open');
      overlay.classList.add('active', 'is-open');
      modal.setAttribute('aria-hidden', 'false');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.classList.add('overflow-hidden');
      if (passwordInput) setTimeout(() => passwordInput.focus(), 150);
    }

    function closeModal() {
      if (!modal || !overlay) return;
      modal.classList.remove('active', 'is-open');
      overlay.classList.remove('active', 'is-open');
      modal.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('overflow-hidden');
    }

    if (openBtn) openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (overlay) overlay.addEventListener('click', closeModal);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
        closeModal();
      }
    });

    // Auto-open modal if there were password errors
    if (document.querySelector('.storefront-password-form .password-alert-error')) {
      openModal();
    }
  })();
</script>

{% schema %}
{
  "name": "Coming Soon Screen",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Label",
      "default": "DROPPING SEPTEMBER 24"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "The Next Standard in Footwear Craft."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Factory laces were made to save margins. laceyaan laces are engineered to honor design. Slow shuttle-loomed weaves, 10mm chunky braids, 3M nocturnal reflective cords, and solid CNC naval brass aglets."
    },
    {
      "type": "text",
      "id": "launch_date",
      "label": "Launch Date (ISO 8601)",
      "default": "2026-09-24T00:00:00+05:30",
      "info": "Format: YYYY-MM-DDTHH:MM:SS+05:30"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Title",
      "default": "Get Priority Access On Launch Day"
    },
    {
      "type": "textarea",
      "id": "newsletter_subtext",
      "label": "Newsletter Description",
      "default": "Be the first in rotation. Early access link and limited edition aglet kit reservation drop to your inbox."
    }
  ]
}
{% endschema %}

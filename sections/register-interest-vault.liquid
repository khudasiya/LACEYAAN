{%- comment -%}
  LACEYAAN Register Interest - Community Prototype Vault
  Showcases concept silhouettes where customers cannot buy, but can register interest via live voting.
{%- endcomment -%}

<section id="register-interest-vault" class="register-interest-section section-padding is-register-interest-collection" {{ section.shopify_attributes }}>
  <div class="container">
    <!-- Header -->
    <div class="collection-header text-center">
      <div class="interest-collection-badge">
        <span class="live-pulse-dot" aria-hidden="true"></span>
        <span>{{ section.settings.badge_text | default: 'COMMUNITY PROTOTYPE VAULT // VOTING OPEN' }}</span>
      </div>
      <h2 class="editorial-heading">{{ section.settings.heading | default: 'Register Interest' }}</h2>
      <div class="collection-desc-wrap section-subtitle">
        <p>{{ section.settings.subtitle | default: 'These bespoke weaves are prototype concepts in active development. They are not available for purchase. Cast your vote below to decide which silhouettes enter our next limited drop.' }}</p>
      </div>

      <!-- Live Community Stats Bar -->
      <div class="interest-stats-banner" id="interest-stats-banner">
        <div class="interest-stat-item">
          {%- assign vault_collection = collections[section.settings.collection] -%}
          <span class="stat-number" id="stats-total-concepts">{% if vault_collection.products_count > 0 %}{{ vault_collection.products_count }}{% else %}4{% endif %}</span>
          <span class="stat-title">PROTOTYPES</span>
        </div>
        <div class="stat-divider"></div>
        <div class="interest-stat-item">
          <span class="stat-number" id="stats-total-votes">0</span>
          <span class="stat-title">COMMUNITY VOTES</span>
        </div>
        <div class="stat-divider"></div>
        <div class="interest-stat-item">
          <span class="stat-number" id="stats-top-trending">--</span>
          <span class="stat-title">TOP TRENDING</span>
        </div>
        <div class="stat-divider"></div>
        <div class="interest-stat-item">
          <button type="button" class="btn-admin-stats-open" id="open-interest-admin-btn" title="Open Store Owner Analytics">
            <span>📊 ADMIN STATS</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Product Prototypes Grid -->
    {%- if vault_collection != blank and vault_collection.products_count > 0 -%}
      <div class="product-grid-layout grid-cols-{{ section.settings.columns_desktop | default: 4 }}">
        {%- for product in vault_collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product, is_register_interest: true, is_register_interest_force: true %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <!-- Default Interactive Concept Silhouettes -->
      <div class="product-grid-layout grid-cols-4" id="interest-demo-grid">
        <!-- Concept 1 -->
        <div class="product-card product-card-editorial product-card-interest" data-product-handle="titanium-damier-jacquard" data-product-title="Laser-Etched Titanium Damier">
          <div class="card-media">
            <a href="#vote" class="media-link">
              <img src="{{ 'design-lab-collection.jpg' | asset_url }}" alt="Laser-Etched Titanium Damier" class="primary-img" width="600" height="600" loading="lazy">
            </a>
            <button type="button" class="card-bookmark-btn" aria-label="Save to Wishlist" onclick="this.classList.toggle('is-saved')">
              <svg class="icon-bookmark" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
              </svg>
            </button>
            <div class="card-badges">
              <span class="badge badge-gold">CONCEPT PROTOTYPE</span>
            </div>
            <div class="card-carousel-dots" aria-hidden="true">
              <span class="dot active"></span>
              <span class="dot"></span>
              <span class="dot"></span>
            </div>
          </div>
          <div class="card-content">
            <div class="card-info-row">
              <div class="card-details-col">
                <h3 class="card-title"><a href="#vote">Laser-Etched Titanium Damier</a></h3>
                <div class="card-price-row">
                  <span class="price-prototype">CONCEPT SILHOUETTE</span>
                </div>
              </div>
            </div>
            <div class="card-interest-pills-row" data-interest-card data-product-handle="titanium-damier-jacquard" data-product-title="Laser-Etched Titanium Damier">
              <button type="button" class="btn-interest-pill btn-interest-yes" data-vote-btn="interested" data-product-handle="titanium-damier-jacquard" aria-label="Vote Interested">
                <span class="vote-icon">▲</span>
                <span class="vote-label">INTERESTED</span>
                <span class="vote-count-badge" data-count="interested">54</span>
              </button>
              <button type="button" class="btn-interest-pill btn-interest-no" data-vote-btn="not_interested" data-product-handle="titanium-damier-jacquard" aria-label="Vote Pass">
                <span class="vote-icon">▼</span>
                <span class="vote-label">NOT INTERESTED</span>
                <span class="vote-count-badge" data-count="not_interested">3</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Concept 2 -->
        <div class="product-card product-card-editorial product-card-interest" data-product-handle="japanese-indigo-sashiko-rope" data-product-title="Japanese Indigo Sashiko Rope">
          <div class="card-media">
            <a href="#vote" class="media-link">
              <img src="{{ 'lace-brown.jpg' | asset_url }}" alt="Japanese Indigo Sashiko Rope" class="primary-img" width="600" height="600" loading="lazy">

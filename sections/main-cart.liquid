{%- comment -%}
  Dedicated Full Cart Page Section
{%- endcomment -%}

<section class="main-cart-section section-padding" {{ section.shopify_attributes }}>
  <div class="container container-narrow">
    <div class="section-header text-center">
      <span class="badge badge-gold">Order Review</span>
      <h1 class="editorial-heading">{{ 'sections.cart.title' | t }}</h1>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="cart-empty-state text-center">
        <div class="empty-icon-wrap">
          {% render 'icon-shopping-bag' %}
        </div>
        <h3>{{ 'sections.cart.empty' | t }}</h3>
        <p>Discover slow shuttle-loom weaves, weighted brass aglets, and bespoke sneaker upgrades.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn-primary">
          {{ 'sections.cart.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart-page-form" class="cart-page-form">
        <!-- Free Shipping Tracker -->
        {%- assign threshold_amount = settings.free_shipping_threshold | default: 1499 | times: 100 -%}
        <div class="shipping-progress-container" data-threshold="{{ threshold_amount }}">
          <div class="shipping-progress-text">
            {%- if cart.total_price >= threshold_amount -%}
              <div class="shipping-unlocked">
                {% render 'icon-sparkles' %}
                <span>{{ 'sections.cart.free_shipping_eligible' | t }}</span>
              </div>
            {%- else -%}
              {%- assign remaining = threshold_amount | minus: cart.total_price -%}
              <div class="shipping-remaining">
                <span>Add <strong>{{ remaining | money }}</strong> more for Complimentary Express Shipping</span>
              </div>
            {%- endif -%}
          </div>
          {%- assign progress_pct = cart.total_price | times: 100.0 | divided_by: threshold_amount | at_most: 100 -%}
          <div class="shipping-progress-bar">
            <div class="shipping-progress-fill" style="width: {{ progress_pct }}%;"></div>
          </div>
        </div>

        <div class="cart-page-table">
          <div class="cart-page-thead">
            <span class="col-item">Product</span>
            <span class="col-price">Price</span>
            <span class="col-qty">Quantity</span>
            <span class="col-total">Total</span>
          </div>

          <div class="cart-page-tbody">
            {%- for item in cart.items -%}
              <div class="cart-page-row" data-key="{{ item.key }}">
                <div class="col-item item-cell">
                  <div class="item-thumb">
                    {%- if item.image -%}
                      <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="100" loading="lazy">
                    {%- endif -%}
                  </div>
                  <div class="item-meta">
                    <h4 class="item-title"><a href="{{ item.url }}">{{ item.product.title }}</a></h4>
                    {%- unless item.product.has_only_default_variant -%}
                      <div class="item-options">
                        {%- for option in item.options_with_values -%}
                          <span class="item-option-pill">{{ option.name }}: {{ option.value }}</span>
                        {%- endfor -%}
                      </div>
                    {%- endunless -%}
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="remove-link">
                      {{ 'sections.cart.remove' | t }}
                    </a>
                  </div>
                </div>

                <div class="col-price price-cell">
                  <span>{{ item.original_price | money }}</span>
                </div>

                <div class="col-qty qty-cell">
                  <div class="quantity-control">
                    <button type="button" class="qty-btn" onclick="location.href='{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}'">-</button>
                    <span class="qty-display">{{ item.quantity }}</span>
                    <button type="button" class="qty-btn" onclick="location.href='{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}'">+</button>
                  </div>
                </div>

                <div class="col-total total-cell">
                  <strong>{{ item.final_line_price | money }}</strong>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <!-- Cart Summary Footer -->
        <div class="cart-page-footer">
          <div class="cart-note-col">
            <label for="cart-page-note">{{ 'sections.cart.note' | t }}</label>
            <textarea name="note" id="cart-page-note" placeholder="Special length instructions or sneaker models...">{{ cart.note }}</textarea>
          </div>

          <div class="cart-totals-col">
            <div class="subtotal-row">
              <span class="subtotal-label">{{ 'sections.cart.subtotal' | t }}</span>
              <span class="subtotal-amount">{{ cart.total_price | money }}</span>
            </div>
            <p class="shipping-notice">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>

            <div class="cart-actions-row">
              <button type="submit" name="update" class="btn-secondary">Update Bag</button>
              <button type="submit" name="checkout" class="btn-primary btn-checkout">
                {% render 'icon-shield-check' %}
                <span>{{ 'sections.cart.checkout' | t }}</span>
              </button>
            </div>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}

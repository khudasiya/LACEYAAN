{%- comment -%}
  Dedicated Full Cart Page Section
{%- endcomment -%}

<section class="main-cart-section section-padding" {{ section.shopify_attributes }}>
  <div class="container container-narrow">
    <div class="section-header text-center">
      <span class="badge badge-gold">Order Review</span>
      <h1 class="editorial-heading">{{ 'sections.cart.title' | t }}</h1>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="cart-empty-state text-center">
        <div class="empty-icon-wrap">
          {% render 'icon-shopping-bag' %}
        </div>
        <h3>{{ 'sections.cart.empty' | t }}</h3>
        <p>Discover slow shuttle-loom weaves, weighted brass aglets, and bespoke sneaker upgrades.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn-primary">
          {{ 'sections.cart.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart-page-form" class="cart-page-form">
        <!-- Free Shipping Tracker -->
        {%- assign threshold_amount = settings.free_shipping_threshold | default: 1499 | times: 100 -%}
        <div class="shipping-progress-container" data-threshold="{{ threshold_amount }}">
          <div class="shipping-progress-text">
            {%- if cart.total_price >= threshold_amount -%}
              <div class="shipping-unlocked">
                {% render 'icon-sparkles' %}
                <span>{{ 'sections.cart.free_shipping_eligible' | t }}</span>
              </div>
            {%- else -%}
              {%- assign remaining = threshold_amount | minus: cart.total_price -%}
              <div class="shipping-remaining">
                <span>Add <strong>{{ remaining | money }}</strong> more for Complimentary Express Shipping</span>
              </div>
            {%- endif -%}
          </div>
          {%- assign progress_pct = cart.total_price | times: 100.0 | divided_by: threshold_amount | at_most: 100 -%}
          <div class="shipping-progress-bar">
            <div class="shipping-progress-fill" style="width: {{ progress_pct }}%;"></div>
          </div>
        </div>

        <div class="cart-page-table">
          <div class="cart-page-thead">
            <span class="col-item">Product</span>
            <span class="col-price">Price</span>
            <span class="col-qty">Quantity</span>
            <span class="col-total">Total</span>
          </div>

          <div class="cart-page-tbody">
            {%- for item in cart.items -%}
              <div class="cart-page-row" data-key="{{ item.key }}">
                <div class="col-item item-cell">
                  <div class="item-thumb">
                    {%- if item.image -%}
                      <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="100" loading="lazy">
                    {%- endif -%}
                  </div>
                  <div class="item-meta">
                    <h4 class="item-title"><a href="{{ item.url }}">{{ item.product.title }}</a></h4>
                    {%- unless item.product.has_only_default_variant -%}
                      <div class="item-options">
                        {%- for option in item.options_with_values -%}
                          <span class="item-option-pill">{{ option.name }}: {{ option.value }}</span>
                        {%- endfor -%}
                      </div>
                    {%- endunless -%}
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="remove-link">
                      {{ 'sections.cart.remove' | t }}
                    </a>
                  </div>
                </div>

                <div class="col-price price-cell">
                  <span>{{ item.original_price | money }}</span>
                </div>

                <div class="col-qty qty-cell">
                  <div class="quantity-control">
                    <button type="button" class="qty-btn" onclick="location.href='{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}'">-</button>
                    <span class="qty-display">{{ item.quantity }}</span>
                    <button type="button" class="qty-btn" onclick="location.href='{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}'">+</button>
                  </div>
                </div>

                <div class="col-total total-cell">
                  <strong>{{ item.final_line_price | money }}</strong>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <!-- Cart Summary Footer -->
        <div class="cart-page-footer">
          <div class="cart-note-col">
            <label for="cart-page-note">{{ 'sections.cart.note' | t }}</label>
            <textarea name="note" id="cart-page-note" placeholder="Special length instructions or sneaker models...">{{ cart.note }}</textarea>

            <!-- Delivery Experience Selector -->
            {%- assign enable_founder_delivery = section.settings.enable_founder_delivery | default: true -%}
            {%- if enable_founder_delivery -%}
              {%- assign is_founder = false -%}
              {%- if cart.attributes['delivery_method'] contains 'Founder' or cart.attributes['Delivery Method'] contains 'Founder' -%}
                {%- assign is_founder = true -%}
              {%- endif -%}
              {%- assign founder_fee = section.settings.founder_delivery_fee | default: 3000 -%}
              {%- assign founder_fee_cents = founder_fee | times: 100 -%}
              <div class="cart-delivery-selector-card" id="cart-delivery-selector" data-founder-fee="{{ founder_fee_cents }}" data-founder-variant-id="{{ section.settings.founder_delivery_product.selected_or_first_available_variant.id }}">
                <div class="delivery-selector-header">
                  <span class="delivery-selector-title">Select Delivery Experience</span>
                  <span class="delivery-selector-sub">Direct from our atelier</span>
                </div>

                <div class="delivery-options-grid">
                  <!-- Standard Delivery -->
                  <label class="delivery-option-box{% unless is_founder %} is-selected{% endunless %}" data-delivery-type="standard">
                    <input 
                      type="radio" 
                      name="attributes[delivery_method]" 
                      value="Standard Atelier Shipping" 
                      class="delivery-radio-input visually-hidden"
                      {% unless is_founder %}checked{% endunless %}
                      data-delivery-radio="standard"
                    >
                    <div class="delivery-box-indicator">
                      <span class="radio-dot"></span>
                    </div>
                    <div class="delivery-box-content">
                      <div class="delivery-box-top">
                        <span class="delivery-name">Standard Courier Delivery</span>
                        <span class="delivery-price free">FREE</span>
                      </div>
                      <p class="delivery-desc">All-India express courier dispatch via Blue Dart / Delhivery.</p>
                    </div>
                  </label>

                  <!-- Hand Delivered by Founder -->
                  <label class="delivery-option-box founder-box{% if is_founder %} is-selected{% endif %}" data-delivery-type="founder">
                    <input 
                      type="radio" 
                      name="attributes[delivery_method]" 
                      value="Hand Delivered by Founder (₹3,000 - Vellore Only)" 
                      class="delivery-radio-input visually-hidden"
                      {% if is_founder %}checked{% endif %}
                      data-delivery-radio="founder"
                    >
                    <div class="delivery-box-indicator">
                      <span class="radio-dot"></span>
                    </div>
                    <div class="delivery-box-content">
                      <div class="delivery-box-top">
                        <div class="delivery-name-group">
                          <span class="delivery-name founder-name">{{ section.settings.founder_delivery_title | default: 'Hand Delivered by Founder' }}</span>
                          <span class="delivery-vellore-badge">{{ section.settings.founder_delivery_badge | default: 'Only available in Vellore' }}</span>
                        </div>
                        <span class="delivery-price founder-price">+ {{ founder_fee_cents | money }}</span>
                      </div>
                      <p class="delivery-desc">{{ section.settings.founder_delivery_desc | default: 'White-glove personal hand delivery and custom lace fitting directly by the LACEYAAN founder.' }}</p>
                    </div>
                  </label>
                </div>

                <!-- Vellore Address & Delivery Note (Shown when Founder option is selected) -->
                <div class="founder-vellore-details" id="cart-founder-vellore-details"{% unless is_founder %} style="display: none;"{% endunless %}>
                  <label for="cart-founder-vellore-address" class="founder-vellore-label">
                    <span>📍 Vellore Location / Delivery Details (Required for Hand Delivery)</span>
                  </label>
                  <input 
                    type="text" 
                    name="attributes[founder_delivery_vellore_address]" 
                    id="cart-founder-vellore-address" 
                    class="founder-vellore-input"
                    placeholder="e.g. VIT Vellore Mens/Womens Hostel Block, Room No., or Street Address..." 
                    value="{{ cart.attributes['founder_delivery_vellore_address'] }}"
                  >
                  <span class="founder-vellore-hint">Our founder will personally coordinate dispatch time directly via your checkout phone number.</span>
                </div>
              </div>
            {%- endif -%}
          </div>

          <div class="cart-totals-col">
            <div class="subtotal-row">
              <span class="subtotal-label">{{ 'sections.cart.subtotal' | t }}</span>
              <span class="subtotal-amount" id="cart-page-base-subtotal" data-base-price="{{ cart.total_price }}">{{ cart.total_price | money }}</span>
            </div>

            <!-- Founder Hand Delivery Row -->
            <div class="founder-fee-row" id="cart-founder-fee-row"{% unless is_founder %} style="display: none;"{% endunless %}>
              <div class="fee-meta">
                <span class="fee-title">Hand Delivered by Founder</span>
                <span class="fee-badge">Vellore Only</span>
              </div>
              <span class="fee-amount" id="cart-page-founder-fee">+ {{ founder_fee_cents | money }}</span>
            </div>

            <!-- Final Checkout Total Row -->
            <div class="cart-final-total-row">
              <span class="final-total-label">Estimated Total</span>
              {%- assign initial_total = cart.total_price -%}
              {%- if is_founder -%}
                {%- assign initial_total = initial_total | plus: founder_fee_cents -%}
              {%- endif -%}
              <span class="final-total-amount" id="cart-page-final-total">{{ initial_total | money }}</span>
            </div>

            <p class="shipping-notice">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>

            <div class="cart-actions-row">
              <a href="{{ routes.all_products_collection_url }}" class="btn-secondary">
                <span>Continue Shopping</span>
              </a>
              <button type="submit" name="checkout" class="btn-primary btn-checkout" id="cart-checkout-button">
                {% render 'icon-shield-check' %}
                <span id="cart-checkout-text">{{ 'sections.cart.checkout' | t | default: 'PROCEED TO SECURE CHECKOUT' }}</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Dynamic App Blocks (Supports Checkout Blocks & Cart Extensibility Apps) -->
        <div class="cart-app-blocks">
          {%- for block in section.blocks -%}
            {%- render block -%}
          {%- endfor -%}
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": [
    {
      "type": "header",
      "content": "Founder Hand Delivery Experience"
    },
    {
      "type": "checkbox",
      "id": "enable_founder_delivery",
      "label": "Enable Hand Delivered by Founder Option",
      "default": true
    },
    {
      "type": "text",
      "id": "founder_delivery_title",
      "label": "Founder Delivery Title",
      "default": "Hand Delivered by Founder"
    },
    {
      "type": "number",
      "id": "founder_delivery_fee",
      "label": "Delivery Charge (in ₹)",
      "default": 3000
    },
    {
      "type": "text",
      "id": "founder_delivery_badge",
      "label": "Availability Tag / Badge",
      "default": "Only available in Vellore"
    },
    {
      "type": "textarea",
      "id": "founder_delivery_desc",
      "label": "Delivery Description",
      "default": "White-glove personal hand delivery and bespoke lace styling directly by the LACEYAAN founder."
    },
    {
      "type": "product",
      "id": "founder_delivery_product",
      "label": "Founder Delivery Add-on Product (Optional)",
      "info": "Select a ₹3,000 product to automatically add as a line item so it passes directly into native Shopify Checkout"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}

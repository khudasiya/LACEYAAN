{%- comment -%}
  LACEYAAN Editorial Hero Banner with Metrics and Trust Marquee
{%- endcomment -%}

<section class="hero-section" {{ section.shopify_attributes }}>
  <div class="hero-bg-media">
    <video 
      id="hero-bg-video" 
      class="hero-video-bg" 
      autoplay 
      loop 
      muted 
      playsinline 
      preload="auto"
      poster="{{ 'drop-01-poster.jpg' | asset_url }}"
    >
      {%- if section.settings.drop_highlights_video_url != blank -%}
        <source src="{{ section.settings.drop_highlights_video_url }}" type="video/mp4">
      {%- endif -%}
      <source src="{{ 'drop-01-highlights.mp4' | asset_url }}" type="video/mp4">
      <source src="{{ 'WhatsApp Video 2026-10-04 at 9.36.32 PM.mp4' | asset_url }}" type="video/mp4">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: 
          class: 'hero-img', 
          widths: '750, 1100, 1500, 1780, 2000, 2400',
          alt: section.settings.heading | escape 
        }}
      {%- else -%}
        <img src="{{ 'hero.jpg' | asset_url }}" alt="LACEYAAN luxury sneaker shoelaces" class="hero-img" width="1920" height="1080" loading="eager">
      {%- endif -%}
    </video>
    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-content-wrap">
    <div class="hero-inner">
      <div class="hero-header-meta">
        {%- if section.settings.badge != blank -%}
          <div class="hero-badge">
            <span class="spec-dot" aria-hidden="true">●</span>
            <span>[ {{ section.settings.badge }} ]</span>
          </div>
        {%- endif -%}

        <!-- Highlights of Drop 01 In-Motion Badge with Sound Toggle -->
        <div class="hero-reel-badge">
          <span class="live-pulse-dot" aria-hidden="true"></span>
          <span class="live-status-text">DROP 01 // HIGHLIGHTS</span>
          <button type="button" class="hero-audio-toggle" id="hero-sound-toggle" aria-label="Toggle Sound" title="Toggle Sound">
            <svg class="icon-sound-off" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <line x1="23" y1="9" x2="17" y2="15"></line>
              <line x1="17" y1="9" x2="23" y2="15"></line>
            </svg>
            <svg class="icon-sound-on" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none;">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            </svg>
            <span class="btn-text" id="hero-sound-label">AUDIO</span>
          </button>
        </div>
      </div>

      <h1 class="hero-title">
        {{ section.settings.heading }}
      </h1>

      <p class="hero-subtitle">
        {{ section.settings.subtitle }}
      </p>

      <div class="hero-cta-group">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="btn-primary hero-btn-primary">
            <span>{{ section.settings.button_1_label }}</span>
            <span class="btn-arrow">[ &rarr; ]</span>
          </a>
        {%- endif -%}

        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link | default: '/pages/length-guide' }}" class="btn-secondary hero-btn-secondary">
            <span>{{ section.settings.button_2_label }}</span>
          </a>
        {%- endif -%}
      </div>

      <!-- Key Metrics Counter Grid -->
      {%- if section.settings.show_metrics != false and section.settings.metric_1_val != blank or section.settings.metric_2_val != blank or section.settings.metric_3_val != blank -%}
        <div class="hero-metrics-grid">
          <span class="metric-crosshair crosshair-tl" aria-hidden="true">+</span>
          <span class="metric-crosshair crosshair-tr" aria-hidden="true">+</span>
          {%- if section.settings.metric_1_val != blank -%}
            <div class="metric-item">
              <span class="metric-val">{{ section.settings.metric_1_val }}</span>
              <span class="metric-lbl">{{ section.settings.metric_1_lbl }}</span>
            </div>
          {%- endif -%}
          {%- if section.settings.metric_1_val != blank and section.settings.metric_2_val != blank -%}
            <div class="metric-divider"></div>
          {%- endif -%}
          {%- if section.settings.metric_2_val != blank -%}
            <div class="metric-item">
              <span class="metric-val">{{ section.settings.metric_2_val }}</span>
              <span class="metric-lbl">{{ section.settings.metric_2_lbl }}</span>
            </div>
          {%- endif -%}
          {%- if section.settings.metric_3_val != blank and section.settings.metric_2_val != blank or section.settings.metric_3_val != blank and section.settings.metric_1_val != blank -%}
            <div class="metric-divider"></div>
          {%- endif -%}
          {%- if section.settings.metric_3_val != blank -%}
            <div class="metric-item">
              <span class="metric-val">{{ section.settings.metric_3_val }}</span>
              <span class="metric-lbl">{{ section.settings.metric_3_lbl }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <!-- Continuous Trust Marquee Ticker -->
  <div class="hero-marquee-bar" aria-hidden="true">
    <div class="marquee-track">
      {%- for i in (1..2) -%}
        <div class="marquee-content">
          <span class="marquee-bullet">✦</span>
          <span>SOLID CNC-MILLED BRASS AGLETS [ 3.8MM ]</span>
          <span class="marquee-bullet">✦</span>
          <span>JAPANESE SHUTTLE-LOOM COMBED COTTON</span>
          <span class="marquee-bullet">✦</span>
          <span>30-DAY GUARANTEED FIT PROMISE</span>
          <span class="marquee-bullet">✦</span>
          <span>ORGANIC NATURAL BEESWAX INFUSION</span>
          <span class="marquee-bullet">✦</span>
          <span>ENGINEERED FOR SNEAKERHEADS &amp; BESPOKE FOOTWEAR</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Background Image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "THE NEW STANDARD IN FOOTWEAR CRAFT"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading (Supports italics for luxury serif accent)",
      "default": "Elevate Every Step. <em>Precision Laces</em> for Every Style."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Factory laces were made to save margins. laceyaan laces are engineered to honor design. Hand-finished in solid brass and Japanese combed cotton to elevate your sneakers, sport shoes, formal wear, and boots."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary Button Label",
      "default": "Shop All Laces"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary Button Label",
      "default": "Find Your Length"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Metrics"
    },
    {
      "type": "checkbox",
      "id": "show_metrics",
      "label": "Show Metrics Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "metric_1_val",
      "label": "Metric 1 Value",
      "default": "3.8mm"
    },
    {
      "type": "text",
      "id": "metric_1_lbl",
      "label": "Metric 1 Label",
      "default": "Universal Eyelet Fit"
    },
    {
      "type": "text",
      "id": "metric_2_val",
      "label": "Metric 2 Value",
      "default": "20,000"
    },
    {
      "type": "text",
      "id": "metric_2_lbl",
      "label": "Metric 2 Label",
      "default": "Tension Cycle Durability"
    },
    {
      "type": "text",
      "id": "metric_3_val",
      "label": "Metric 3 Value",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "metric_3_lbl",
      "label": "Metric 3 Label",
      "default": "Solid Milled Metal Aglets"
    },
    {
      "type": "header",
      "content": "Highlights of Drop 01 Reel"
    },
    {
      "type": "checkbox",
      "id": "show_drop_highlights",
      "label": "Show Highlights of Drop 01 Video Card",
      "default": true
    },
    {
      "type": "url",
      "id": "drop_highlights_video_url",
      "label": "Custom Video URL (Optional from Shopify Content > Files)",
      "info": "Leave blank to use the bundled Drop 01 highlight video."
    },
    {
      "type": "text",
      "id": "drop_highlights_badge",
      "label": "Highlights Badge Text",
      "default": "DROP 01 // HIGHLIGHTS"
    },
    {
      "type": "text",
      "id": "drop_highlights_title",
      "label": "Highlights Title",
      "default": "HIGHLIGHTS OF DROP 01"
    },
    {
      "type": "textarea",
      "id": "drop_highlights_desc",
      "label": "Highlights Description",
      "default": "Slow-crafted weaves in kinetic motion. Universal 3.8mm CNC aglets on bespoke footwear."
    },
    {
      "type": "text",
      "id": "drop_highlights_tag1",
      "label": "Spec Tag 1",
      "default": "4 SIGNATURE WEAVES"
    },
    {
      "type": "text",
      "id": "drop_highlights_tag2",
      "label": "Spec Tag 2",
      "default": "SOLID MILLED BRASS"
    },
    {
      "type": "text",
      "id": "drop_highlights_tag3",
      "label": "Spec Tag 3",
      "default": "ZERO RESTOCKS"
    }
  ],
  "presets": [
    {
      "name": "Editorial Hero Banner"
    }
  ]
}
{% endschema %}

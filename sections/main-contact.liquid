{%- comment -%}
  LACEYAAN Atelier Contact Section
  Native Shopify contact form (name, email, message). Submissions are emailed
  by Shopify to the store's contact email (Settings > General / Notifications).
{%- endcomment -%}

<section class="main-contact-section section-padding">
  <div class="container container-narrow">
    <div class="contact-editorial-card">
      <div class="contact-head text-center">
        <span class="badge badge-gold">✦ ATELIER CONCIERGE DIRECT</span>
        <h1 class="contact-title editorial-heading">Contact Us</h1>
        <p class="contact-subtitle">
          Orders, sizing questions, archive collection inquiries or custom wholesale requests &mdash; write to us and our atelier concierge will reply within 24 business hours.
        </p>
      </div>

      {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="contact-form-status is-success" role="status" tabindex="-1">
            <span class="status-icon" aria-hidden="true">&#10003;</span>
            <span>Thank you &mdash; your message is on its way. We&rsquo;ll get back to you within 24 business hours.</span>
          </div>
        {%- elsif form.errors -%}
          <div class="contact-form-status is-error" role="alert" tabindex="-1">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="contact-form-grid">
          <div class="contact-field">
            <label for="ContactForm-name">Name</label>
            <input
              id="ContactForm-name"
              type="text"
              name="contact[name]"
              autocomplete="name"
              placeholder="Your full name"
              required
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>

          <div class="contact-field">
            <label for="ContactForm-email">Email</label>
            <input
              id="ContactForm-email"
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              placeholder="you@example.com"
              required
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            >
          </div>

          <div class="contact-field contact-field--full">
            <label for="ContactForm-message">Message</label>
            <textarea
              id="ContactForm-message"
              name="contact[body]"
              rows="6"
              placeholder="Tell us about your order, sneaker model or custom request..."
              required
            >{{ form.body }}</textarea>
          </div>
        </div>

        <button type="submit" class="contact-submit-btn">
          <span>Send Message</span>
          <span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </button>
      {%- endform -%}

      <div class="contact-details-grid">
        <div class="contact-detail-item">
          <span class="detail-label">OFFICIAL INBOX</span>
          <a href="mailto:sharmaom.2424@gmail.com" class="detail-value highlight-gold">sharmaom.2424@gmail.com</a>
        </div>
        <div class="contact-detail-item">
          <span class="detail-label">CONCIERGE HOURS</span>
          <span class="detail-value">Mon &ndash; Sat &bull; 10:00 AM &ndash; 7:00 PM IST</span>
        </div>
        <div class="contact-detail-item">
          <span class="detail-label">AVERAGE RESPONSE</span>
          <span class="detail-value">Within 24 Business Hours</span>
        </div>
        <div class="contact-detail-item">
          <span class="detail-label">DISPATCH ATELIER</span>
          <span class="detail-value">New Delhi, India (110001)</span>
        </div>
      </div>

      <div class="contact-policy-links">
        <a href="/policies/shipping-policy" class="text-link">Shipping Policy</a>
        <span class="sep">&bull;</span>
        <a href="/policies/privacy-policy" class="text-link">Privacy Policy</a>
        <span class="sep">&bull;</span>
        <a href="/policies/terms-of-service" class="text-link">Terms of Service</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Form",
  "settings": []
}
{% endschema %}

{%- comment -%}
  LACEYAAN Luxury Header with Mega Menu, Live Cart Count, and Mobile Drawer
{%- endcomment -%}

<header id="site-header" class="site-header{% if section.settings.enable_sticky_header %} sticky-header{% endif %}">
  <div class="navbar">
    <div class="container navbar-inner">
      <!-- Left: Mobile Menu Toggle & Desktop Navigation -->
      <div class="navbar-left">
        <button 
          type="button" 
          class="mobile-menu-toggle" 
          id="mobile-menu-toggle" 
          data-mobile-menu-trigger
          aria-label="{{ 'sections.header.menu' | t }}"
          aria-controls="mobile-drawer"
          aria-expanded="false"
        >
          {% render 'icon-menu' %}
        </button>

        <nav class="desktop-nav" role="navigation" aria-label="Main Navigation">
          <ul class="nav-links-list">
            {%- for link in linklists[section.settings.menu].links -%}
              <li class="nav-item{% if link.links != blank %} has-dropdown{% endif %}">
                <a href="{{ link.url }}" class="nav-link{% if link.current %} active{% endif %}">
                  <span>{{ link.title }}</span>
                  {%- if link.links != blank -%}
                    {% render 'icon-chevron-down' %}
                  {%- endif -%}
                </a>

                {%- if link.links != blank -%}
                  <div class="mega-menu-dropdown">
                    <div class="mega-menu-container">
                      <div class="mega-menu-columns">
                        <div class="mega-column">
                          <h4 class="mega-column-title">{{ link.title }} Collections</h4>
                          <ul class="mega-sublinks">
                            {%- for child_link in link.links -%}
                              <li>
                                <a href="{{ child_link.url }}" class="mega-link{% if child_link.current %} active{% endif %}">
                                  {{ child_link.title }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>

                        <!-- Atelier Feature Panel inside dropdown -->
                        <div class="mega-feature-card">
                          <span class="badge badge-gold">Slow-Crafted Weaves</span>
                          <h4>Solid CNC Naval Brass Aglets</h4>
                          <p>100% Japanese long-staple cotton shuttle-loomed with natural micro-beeswax infusion.</p>
                          <a href="{{ routes.all_products_collection_url }}" class="mega-cta-link">
                            <span>Explore Atelier Catalog &rarr;</span>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}

            {%- if linklists[section.settings.menu].links.size == 0 -%}
              <li class="nav-item">
                <a href="{{ routes.all_products_collection_url }}" class="nav-link">
                  <span>New In</span>
                </a>
              </li>
              <li class="nav-item">
                <a href="/collections" class="nav-link">
                  <span>Collections</span>
                </a>
              </li>
              <li class="nav-item">
                <a href="/pages/lookbook" class="nav-link">
                  <span>Lookbook</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      </div>

      <!-- Center: Brand Logo -->
      <div class="navbar-center">
        {%- assign header_shop_name = shop.name -%}
        {%- if header_shop_name == 'My Store' or header_shop_name == blank -%}
          {%- assign header_shop_name = 'LACEYAAN' -%}
        {%- endif -%}
        <a href="{{ routes.root_url }}" class="brand-logo-link" aria-label="{{ header_shop_name }}">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 340 | image_tag: 
              class: 'brand-logo-img', 
              widths: '170, 340',
              alt: header_shop_name | escape 
            }}
          {%- else -%}
            <div class="brand-text-logo">
              <div class="brand-lockup">
                <img 
                  src="{{ 'logo-icon.png' | asset_url }}" 
                  alt="LACEYAAN Braided Emblem" 
                  class="brand-icon-mark"
                  width="26"
                  height="28"
                  loading="eager"
                >
                <span class="logo-title">LACEYAAN</span>
              </div>
            </div>
          {%- endif -%}
        </a>
      </div>

      <!-- Right: Utility Icons -->
      <div class="navbar-right">
        <div class="navbar-utilities">
          {%- if settings.social_instagram_link != blank -%}
            <a 
              href="{{ settings.social_instagram_link }}" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="nav-util-btn util-instagram" 
              aria-label="Instagram @laceyaan_"
              title="Follow @laceyaan_ on Instagram"
            >
              {% render 'icon-instagram' %}
            </a>
          {%- endif -%}

          <button 
            type="button" 
            class="nav-util-btn" 
            id="open-search-modal" 
            aria-label="{{ 'sections.header.search' | t }}"
          >
            {% render 'icon-search' %}
            <span class="util-label">Search</span>
          </button>

          {%- if shop.customer_accounts_enabled -%}
            <a 
              href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" 
              class="nav-util-btn nav-account-btn" 
              id="header-account-btn"
              aria-label="{% if customer %}Account: {{ customer.first_name }}{% else %}{{ 'sections.header.account' | t | default: 'Sign In' }}{% endif %}"
              title="{% if customer %}Account: {{ customer.first_name }}{% else %}Sign In{% endif %}"
            >
              {% render 'icon-user' %}
              <span class="util-label">{% if customer %}{{ customer.first_name | default: 'Account' }}{% else %}Sign In{% endif %}</span>
            </a>
          {%- else -%}
            <a 
              href="{{ routes.account_login_url }}" 
              class="nav-util-btn nav-account-btn" 
              id="header-account-btn"
              aria-label="Customer Account & Orders"
              title="Customer Account & Orders"
            >
              {% render 'icon-user' %}
              <span class="util-label">Sign In</span>
            </a>
          {%- endif -%}

          <button 
            type="button" 
            class="nav-util-btn wishlist-btn" 
            id="open-wishlist-btn" 
            aria-label="Wishlist"
            title="Saved Items"
          >
            <svg class="icon icon-bookmark" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
            <span class="util-label">Wishlist</span>
          </button>

          <button 
            type="button" 
            class="nav-util-btn bag-btn" 
            id="open-cart-drawer" 
            aria-label="{{ 'sections.header.bag' | t }}"
          >
            {% render 'icon-shopping-bag' %}
            <span class="util-label">Bag</span>
            <span class="bag-count-bubble" id="header-cart-count">{{ cart.item_count }}</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div id="mobile-drawer-overlay" class="mobile-drawer-overlay" data-mobile-menu-overlay aria-hidden="true"></div>
<div id="mobile-drawer" class="mobile-drawer" data-mobile-menu-drawer role="dialog" aria-modal="true" aria-label="Mobile Navigation" aria-hidden="true">
  <div class="mobile-drawer-header">
    <div class="brand-text-logo">
      <div class="brand-lockup">
        <img 
          src="{{ 'logo-icon.png' | asset_url }}" 
          alt="LACEYAAN Braided Emblem" 
          class="brand-icon-mark drawer-logo-img"
          width="28"
          height="32"
          loading="eager"
        >
        <span class="logo-title">LACEYAAN</span>
      </div>
    </div>
    <button type="button" class="drawer-close-btn" id="close-mobile-drawer" data-mobile-menu-close aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon-close' %}
    </button>
  </div>

  <div class="mobile-drawer-content">
    <nav class="mobile-nav-list" role="navigation">
      {%- for link in linklists[section.settings.menu].links -%}
        <div class="mobile-nav-group">
          {%- if link.links != blank -%}
            <button type="button" class="mobile-nav-accordion-btn" data-dropdown-trigger>
              <span>{{ link.title }}</span>
              {% render 'icon-chevron-down' %}
            </button>
            <div class="mobile-subnav-panel">
              {%- for child_link in link.links -%}
                <a href="{{ child_link.url }}" class="mobile-sublink{% if child_link.current %} active{% endif %}">
                  {{ child_link.title }}
                </a>
              {%- endfor -%}
            </div>
          {%- else -%}
            <a href="{{ link.url }}" class="mobile-nav-link{% if link.current %} active{% endif %}">
              {{ link.title }}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- if linklists[section.settings.menu].links.size == 0 -%}
        <div class="mobile-nav-group">
          <a href="{{ routes.all_products_collection_url }}" class="mobile-nav-link">Shop All Laces</a>
        </div>
        <div class="mobile-nav-group">
          <a href="/pages/lookbook" class="mobile-nav-link">Lookbook</a>
        </div>
        <div class="mobile-nav-group">
          <a href="/pages/length-guide" class="mobile-nav-link">Length Guide</a>
        </div>
      {%- endif -%}
    </nav>

    <!-- Mobile Drawer Customer Account Hub -->
    <div class="mobile-drawer-account-box">
      {%- if customer -%}
        <div class="mobile-account-user-row">
          <div class="mobile-avatar-badge">{{ customer.first_name | slice: 0, 1 | default: 'L' }}</div>
          <div class="mobile-user-details">
            <span class="mobile-welcome-lbl">SIGNED IN AS</span>
            <span class="mobile-user-name">{{ customer.name }}</span>
          </div>
        </div>
        <div class="mobile-account-links-row">
          <a href="{{ routes.account_url }}" class="btn-primary btn-sm mobile-account-btn">
            <span>MY ACCOUNT &amp; ORDERS &rarr;</span>
          </a>
          <a href="{{ routes.account_logout_url }}" class="btn-secondary btn-sm mobile-logout-btn">
            <span>SIGN OUT</span>
          </a>
        </div>
      {%- else -%}
        <div class="mobile-account-guest-row">
          <div class="mobile-guest-text">
            <span class="mobile-guest-title">Atelier Member Access</span>
            <span class="mobile-guest-sub">Sign in to track orders or join the rotation</span>
          </div>
          <div class="mobile-auth-buttons-grid">
            <a href="{{ routes.account_login_url }}" class="btn-primary btn-sm">
              <span>SIGN IN</span>
            </a>
            <a href="{{ routes.account_register_url }}" class="btn-secondary btn-sm">
              <span>REGISTER</span>
            </a>
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- Mobile Drawer Footer Contact & Social -->
    <div class="mobile-drawer-footer">
      <p class="mobile-shipping-note">Free standard domestic express courier across India over ₹1,499.</p>
      
      <div class="mobile-contact-row">
        <span>Atelier Support:</span>
        <a href="mailto:laceyaan@gmail.com" class="mobile-email-link">laceyaan@gmail.com</a>
      </div>

      {%- if settings.social_instagram_link != blank -%}
        <div class="mobile-social-row">
          <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" class="mobile-insta-btn">
            {% render 'icon-instagram' %}
            <span>Follow @laceyaan_ on Instagram</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable sticky header on scroll",
      "default": true
    }
  ]
}
{% endschema %}

[
  {
    "name": "theme_info",
    "theme_name": "LACEYAAN Atelier",
    "theme_version": "2.0.0",
    "theme_author": "LACEYAAN",
    "theme_documentation_url": "https://github.com/khudasiya/LACEYAAN",
    "theme_support_url": "mailto:laceyaan@gmail.com"
  },
  {
    "name": "Brand Identity",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo Image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Custom logo width",
        "default": 170
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled to 32x32px"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg_primary",
        "label": "Primary Background",
        "default": "#FAF9F5"
      },
      {
        "type": "color",
        "id": "color_bg_dark",
        "label": "Dark Background",
        "default": "#141311"
      },
      {
        "type": "color",
        "id": "color_bg_surface",
        "label": "Dark Surface Background",
        "default": "#1E1D1B"
      },
      {
        "type": "color",
        "id": "color_text_main",
        "label": "Main Text Color",
        "default": "#1E1D1B"
      },
      {
        "type": "color",
        "id": "color_text_light",
        "label": "Light Text Color",
        "default": "#FAF9F5"
      },
      {
        "type": "color",
        "id": "color_accent_gold",
        "label": "Accent Gold Color",
        "default": "#C5A880"
      },
      {
        "type": "color",
        "id": "color_accent_gold_dark",
        "label": "Accent Gold Dark",
        "default": "#A38760"
      }
    ]
  },
  {
    "name": "Cart Drawer & Shipping",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart Type",
        "options": [
          { "value": "drawer", "label": "Slide-out Drawer" },
          { "value": "page", "label": "Dedicated Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold (Amount in store currency, e.g. 1499)",
        "default": 1499
      },
      {
        "type": "checkbox",
        "id": "enable_cart_notes",
        "label": "Enable Cart Notes / Special Instructions",
        "default": true
      }
    ]
  },
  {
    "name": "Product Cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_secondary_image",
        "label": "Show secondary image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show product vendor / atelier label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_rating",
        "label": "Show product star rating",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_quick_view",
        "label": "Enable Quick View Modal",
        "default": true
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram URL",
        "default": "https://www.instagram.com/laceyaan_"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "Twitter/X URL"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube URL"
      }
    ]
  }
]

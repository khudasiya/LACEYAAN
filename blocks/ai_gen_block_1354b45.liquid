{% doc %}
  @prompt
    add a photo i am going to give you , make this photo in here and also add a button buy now , i want to add collection in buy now button 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign photo_class = 'ai-photo-collection-' | append: ai_gen_id | append: '__image' %}

{% style %}
.ai-photo-collection-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin-inline:auto;text-align:{{ block.settings.alignment }};}
.ai-photo-collection-{{ ai_gen_id }}__image{display:block;width:100%;height:auto;border-radius:{{ block.settings.corner_radius }}px;}
.ai-photo-collection-{{ ai_gen_id }}__placeholder{position:relative;width:100%;aspect-ratio:4/3;overflow:hidden;border-radius:{{ block.settings.corner_radius }}px;background:#FAF9F5;}
.ai-photo-collection-{{ ai_gen_id }}__placeholder svg{display:block;width:100%;height:100%;color:#C5A880;}
.ai-photo-collection-{{ ai_gen_id }}__empty{position:absolute;right:16px;bottom:16px;left:16px;margin:0;color:#1E1D1B;font-size:14px;text-align:center;}
.ai-photo-collection-{{ ai_gen_id }}__caption{margin:12px 0 16px;color:#1E1D1B;font-size:14px;line-height:1.5;}
.ai-photo-collection-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 28px;border:1px solid #1E1D1B;border-radius:{{ block.settings.button_radius }}px;background:#1E1D1B;color:#FAF9F5;font:inherit;font-size:15px;text-decoration:none;}
.ai-photo-collection-{{ ai_gen_id }}__button:hover{background:#C5A880;color:#1E1D1B;}
.ai-photo-collection-{{ ai_gen_id }}__button:focus-visible{outline:2px solid #A38760;outline-offset:3px;}
{% endstyle %}

<div class="ai-photo-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.photo != blank %}
    {{ block.settings.photo | image_url: width: 2400 | image_tag: class: photo_class, loading: 'lazy', alt: block.settings.photo.alt }}
  {% else %}
    <div class="ai-photo-collection-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<p class="ai-photo-collection-{{ ai_gen_id }}__empty">Choose your photo in the Photo setting.</p></div>
  {% endif %}
  {% if block.settings.caption != blank %}<p class="ai-photo-collection-{{ ai_gen_id }}__caption">{{ block.settings.caption | escape }}</p>{% endif %}
  {% if block.settings.collection != blank %}<a class="ai-photo-collection-{{ ai_gen_id }}__button" href="{{ block.settings.collection.url }}">{{ block.settings.button_label | escape }}</a>{% endif %}
</div>

{% schema %}
{
  "name": "Photo with collection",
  "settings": [
    {"type":"image_picker","id":"photo","label":"Photo"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop collection"},
    {"type":"text","id":"caption","label":"Caption"},
    {"type":"select","id":"alignment","label":"Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"corner_radius","label":"Image corner radius","min":0,"max":30,"step":2,"unit":"px","default":0},
    {"type":"range","id":"button_radius","label":"Button corner radius","min":0,"max":30,"step":2,"unit":"px","default":0}
  ],
  "presets": [{"name":"Photo with collection"}],
  "tag": null,
  "class": "photo-collection-block"
}
{% endschema %}
{% doc %}
  @prompt
    one section with 2 photos from the leopard lace with buy now option 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-leopard-pair-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: 28px;
  }

  .ai-leopard-pair-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-leopard-pair-{{ ai_gen_id }}__heading {
    margin: 0 0 22px;
    color: inherit;
    text-align: center;
    font-size: clamp(22px, 3vw, 34px);
    line-height: 1.2;
  }

  .ai-leopard-pair-{{ ai_gen_id }}__photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .ai-leopard-pair-{{ ai_gen_id }}__photo,
  .ai-leopard-pair-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: #e8e4de;
  }

  .ai-leopard-pair-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-leopard-pair-{{ ai_gen_id }}__empty {
    padding: 12px;
    color: #514b44;
    text-align: center;
    font-size: 13px;
  }

  .ai-leopard-pair-{{ ai_gen_id }}__details {
    padding-top: 22px;
    text-align: center;
  }

  .ai-leopard-pair-{{ ai_gen_id }}__product-title {
    margin: 0 0 6px;
    font-size: 20px;
    line-height: 1.3;
  }

  .ai-leopard-pair-{{ ai_gen_id }}__price {
    margin: 0 0 16px;
    font-size: 16px;
  }

  .ai-leopard-pair-{{ ai_gen_id }}__button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 30px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: 0;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .ai-leopard-pair-{{ ai_gen_id }}__button:hover {
    background: {{ block.settings.button_text_color }};
    color: {{ block.settings.button_color }};
  }

  .ai-leopard-pair-{{ ai_gen_id }}__button:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 600px) {
    .ai-leopard-pair-{{ ai_gen_id }} {
      padding: 20px 14px;
    }

    .ai-leopard-pair-{{ ai_gen_id }}__photos {
      gap: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-leopard-pair-{{ ai_gen_id }}__button {
      transition: none;
    }
  }
{% endstyle %}

<div class="ai-leopard-pair-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-leopard-pair-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-leopard-pair-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    <div class="ai-leopard-pair-{{ ai_gen_id }}__photos">
      {% for image_number in (1..2) %}
        {% assign image_key = 'photo_' | append: image_number %}
        {% assign photo = block.settings[image_key] %}
        {% if photo != blank %}
          <img
            class="ai-leopard-pair-{{ ai_gen_id }}__photo"
            src="{{ photo | image_url: width: 1200 }}"
            alt="{{ photo.alt | default: block.settings.heading | escape }}"
            loading="lazy"
            width="{{ photo.width }}"
            height="{{ photo.height }}"
          >
        {% else %}
          <div>
            <div class="ai-leopard-pair-{{ ai_gen_id }}__placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
            <div class="ai-leopard-pair-{{ ai_gen_id }}__empty">Add photo {{ image_number }} of the leopard lace</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% assign featured_product = block.settings.featured_product %}
    {% if featured_product != blank %}
      <div class="ai-leopard-pair-{{ ai_gen_id }}__details">
        <h3 class="ai-leopard-pair-{{ ai_gen_id }}__product-title">{{ featured_product.title | escape }}</h3>
        <p class="ai-leopard-pair-{{ ai_gen_id }}__price">{{ featured_product.price | money }}</p>
        <a class="ai-leopard-pair-{{ ai_gen_id }}__button" href="{{ featured_product.url }}">{{ block.settings.button_label | escape }}</a>
      </div>
    {% else %}
      <div class="ai-leopard-pair-{{ ai_gen_id }}__details">
        <span class="ai-leopard-pair-{{ ai_gen_id }}__button" aria-disabled="true">{{ block.settings.button_label | escape }}</span>
        <p class="ai-leopard-pair-{{ ai_gen_id }}__empty">Choose the leopard lace product to enable the buy button.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Leopard lace photos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Leopard lace"
    },
    {
      "type": "image_picker",
      "id": "photo_1",
      "label": "Photo one"
    },
    {
      "type": "image_picker",
      "id": "photo_2",
      "label": "Photo two"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Leopard lace product"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Buy now"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1E1D1B"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#1E1D1B"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FAF9F5"
    }
  ],
  "presets": [
    {
      "name": "Leopard lace photos"
    }
  ],
  "tag": null,
  "class": "leopard-lace-photos"
}
{% endschema %}
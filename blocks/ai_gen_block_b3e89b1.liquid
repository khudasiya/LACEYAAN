{% doc %}
  @prompt
    add doomviels laces like the leopard printed once
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-lace-feature-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: 28px;
  }

  .ai-lace-feature__inner-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 32px;
  }

  .ai-lace-feature__media-{{ ai_gen_id }} {
    overflow: hidden;
    background: #eeeae2;
    aspect-ratio: 4 / 3;
  }

  .ai-lace-feature__media-{{ ai_gen_id }} img,
  .ai-lace-feature__media-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-lace-feature__copy-{{ ai_gen_id }} {
    padding: 10px 0;
  }

  .ai-lace-feature__eyebrow-{{ ai_gen_id }} {
    margin: 0 0 12px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ai-lace-feature__heading-{{ ai_gen_id }} {
    margin: 0 0 14px;
    color: inherit;
    font-size: clamp(25px, 3vw, 38px);
    line-height: 1.15;
  }

  .ai-lace-feature__description-{{ ai_gen_id }} {
    margin: 0 0 20px;
    line-height: 1.6;
  }

  .ai-lace-feature__product-{{ ai_gen_id }} {
    margin: 0 0 20px;
    font-weight: 600;
  }

  .ai-lace-feature__link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 22px;
    border: 1px solid {{ block.settings.accent_color }};
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-weight: 600;
  }

  .ai-lace-feature__link-{{ ai_gen_id }}:focus-visible {
    outline: 3px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-lace-feature-{{ ai_gen_id }} { padding: 20px; }
    .ai-lace-feature__inner-{{ ai_gen_id }} {
      width: 100%;
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .ai-lace-feature__copy-{{ ai_gen_id }} { padding: 0; }
  }
{% endstyle %}

<div class="ai-lace-feature-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-lace-feature__inner-{{ ai_gen_id }}">
    <div class="ai-lace-feature__media-{{ ai_gen_id }}">
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% elsif block.settings.featured_product != blank and block.settings.featured_product.featured_image != blank %}
        <img src="{{ block.settings.featured_product.featured_image | image_url: width: 1400 }}" alt="{{ block.settings.featured_product.featured_image.alt | default: block.settings.featured_product.title | escape }}" loading="lazy" width="{{ block.settings.featured_product.featured_image.width }}" height="{{ block.settings.featured_product.featured_image.height }}">
      {% else %}
        <div class="ai-lace-feature__placeholder-{{ ai_gen_id }}">
          {{ 'product-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
    <div class="ai-lace-feature__copy-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}<p class="ai-lace-feature__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      <h2 class="ai-lace-feature__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
      {% if block.settings.description != blank %}<div class="ai-lace-feature__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>{% endif %}
      {% if block.settings.featured_product != blank %}
        <p class="ai-lace-feature__product-{{ ai_gen_id }}">{{ block.settings.featured_product.title | escape }}{% if block.settings.show_price %} — {{ block.settings.featured_product.price | money }}{% endif %}</p>
        <a class="ai-lace-feature__link-{{ ai_gen_id }}" href="{{ block.settings.featured_product.url }}">{{ block.settings.button_label | escape }}</a>
      {% elsif block.settings.button_link != blank %}
        <a class="ai-lace-feature__link-{{ ai_gen_id }}" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Printed lace feature",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A distinctive finishing touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Leopard-print laces" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Refresh your look with statement laces inspired by a bold animal-print classic.</p>" },
    { "type": "product", "id": "featured_product", "label": "Lace product" },
    { "type": "image_picker", "id": "image", "label": "Feature image" },
    { "type": "checkbox", "id": "show_price", "label": "Show product price", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover the laces" },
    { "type": "url", "id": "button_link", "label": "Fallback button link" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FAF9F5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1E1D1B" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#A38760" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#141311" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FAF9F5" }
  ],
  "presets": [{ "name": "Printed lace feature" }],
  "tag": null,
  "class": "printed-lace-feature"
}
{% endschema %}
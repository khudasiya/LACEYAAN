{%- comment -%}
  Open Graph and Twitter social card tags
{%- endcomment -%}

{%- assign shop_display_name = shop.name -%}
{%- if shop_display_name == 'My Store' or shop_display_name == blank -%}
  {%- assign shop_display_name = 'LACEYAAN' -%}
{%- endif -%}

<meta property="og:site_name" content="{{ shop_display_name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | default: shop_display_name }}">
<meta property="og:type" content="website">
<meta property="og:description" content="{{ page_description | default: shop.description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="http:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | default: shop_display_name }}">
<meta name="twitter:description" content="{{ page_description | default: shop.description | escape }}">

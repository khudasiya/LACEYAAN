{% comment %}
  LACEYAAN Luxury Editorial Product Card
  Pure luxury streetwear catalog product card with clean imagery, titles, real prices, and instant quick-actions.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = product.featured_media
  assign secondary_media = product.media[1]
-%}

<div class="product-card product-card-editorial" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}" data-product-title="{{ product.title | escape }}">
  <!-- Self-contained Product JSON for instant, offline, password-safe data -->
  <script type="application/json" class="product-card-json" data-product-handle="{{ product.handle }}">
    {{ product | json }}
  </script>

  <!-- Editorial Rounded Media Container -->
  <div class="card-media" style="aspect-ratio: 3 / 4;">
    <a href="{{ product.url }}" class="media-link" aria-label="{{ product.title | escape }}">
      {%- if featured_media -%}
        {{ featured_media | image_url: width: 750 | image_tag: 
          loading: 'lazy', 
          widths: '375, 550, 750',
          class: 'primary-img',
          alt: featured_media.alt | default: product.title | escape 
        }}
        {%- if secondary_media and settings.show_secondary_image -%}
          {{ secondary_media | image_url: width: 750 | image_tag: 
            loading: 'lazy', 
            widths: '375, 550, 750',
            class: 'hover-img',
            alt: secondary_media.alt | default: product.title | escape 
          }}
        {%- endif -%}
      {%- else -%}
        <div class="placeholder-image">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </a>
  </div>

  <!-- Editorial Info Row directly below image -->
  <div class="card-content">
    <div class="card-info-row">
      <div class="card-details-col">
        <h3 class="card-title">
          <a href="{{ product.url }}">{{ product.title }}</a>
        </h3>
        <div class="card-price-row">
          <span class="price-now">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="price-compare" style="text-decoration: line-through; opacity: 0.6; font-size: 0.85em; margin-left: 0.4rem;">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>
      </div>

      <!-- Minimalist Bare Plus (+) Quick-Action Button -->
      <button 
        type="button" 
        class="card-action-plus-btn" 
        data-action-plus
        data-variant-id="{{ current_variant.id }}"
        data-product-handle="{{ product.handle }}"
        data-available="{{ current_variant.available }}"
        data-has-variants="{% if product.variants.size > 1 %}true{% else %}false{% endif %}"
        aria-label="Quick Action for {{ product.title | escape }}"
        title="{% if current_variant.available %}Quick add to bag{% else %}View details{% endif %}"
      >
        <span class="plus-symbol">+</span>
      </button>
    </div>
  </div>
</div>

{% comment %}
  Renders a luxury product card matching LACEYAAN Broadcast theme aesthetic
  Usage:
  {% render 'product-card', product: product %}
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = product.featured_media
  assign secondary_media = product.media[1]
-%}

<div class="product-card" data-product-id="{{ product.id }}">
  <div class="card-media">
    <a href="{{ product.url }}" class="media-link" aria-label="{{ product.title | escape }}">
      {%- if featured_media -%}
        {{ featured_media | image_url: width: 750 | image_tag: 
          loading: 'lazy', 
          widths: '375, 550, 750',
          class: 'primary-img',
          alt: featured_media.alt | default: product.title | escape 
        }}
        {%- if secondary_media and settings.show_secondary_image -%}
          {{ secondary_media | image_url: width: 750 | image_tag: 
            loading: 'lazy', 
            widths: '375, 550, 750',
            class: 'hover-img',
            alt: secondary_media.alt | default: product.title | escape 
          }}
        {%- endif -%}
      {%- else -%}
        <div class="placeholder-image">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </a>

    <!-- Badges -->
    <div class="card-badges">
      {%- if current_variant.available == false -%}
        <span class="badge badge-sold-out">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif product.compare_at_price > product.price -%}
        {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
        <span class="badge badge-sale">Save {{ savings }}%</span>
      {%- elsif product.tags contains 'bestseller' -%}
        <span class="badge badge-gold">Bestseller</span>
      {%- elsif product.tags contains 'new' -%}
        <span class="badge badge-new">New Drop</span>
      {%- elsif product.tags contains 'vault' -%}
        <span class="badge badge-dark">Collector Vault</span>
      {%- endif -%}
    </div>

    <!-- Quick View Trigger -->
    {%- if settings.enable_quick_view -%}
      <button 
        type="button" 
        class="quick-view-btn" 
        data-quick-view-trigger="{{ product.handle }}" 
        aria-label="Quick View {{ product.title | escape }}"
      >
        {% render 'icon-eye' %}
        <span>Quick View</span>
      </button>
    {%- endif -%}
  </div>

  <div class="card-content">
    {%- if settings.show_vendor and product.vendor != blank -%}
      <div class="card-category">{{ product.vendor }}</div>
    {%- endif -%}

    <h3 class="card-title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <!-- Price -->
    <div class="card-price-row">
      {% render 'price', product: product, use_variant: true %}
    </div>

    <!-- Options Previews (Lengths or Colors) -->
    {%- for option in product.options_with_values -%}
      {%- assign opt_name = option.name | downcase -%}
      {%- if opt_name contains 'length' -%}
        <div class="card-lengths-preview">
          {%- for val in option.values limit: 4 -%}
            <span class="length-pill-preview">{{ val }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    <!-- Action Buttons -->
    <div class="card-actions">
      {%- if current_variant.available -%}
        <button 
          type="button" 
          class="btn-primary btn-add-bag" 
          data-add-to-cart 
          data-variant-id="{{ current_variant.id }}"
        >
          {% render 'icon-shopping-bag' %}
          <span>{{ 'products.product.add_to_cart' | t }}</span>
        </button>
      {%- else -%}
        <button type="button" class="btn-primary btn-add-bag" disabled>
          <span>{{ 'products.product.sold_out' | t }}</span>
        </button>
      {%- endif -%}

      <a href="{{ product.url }}" class="btn-secondary btn-inspect" aria-label="View {{ product.title | escape }}">
        <span>Details</span>
      </a>
    </div>
  </div>
</div>

{% comment %}
  Renders a luxury product card matching LACEYAAN Broadcast theme aesthetic
  Usage:
  {% render 'product-card', product: product %}
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = product.featured_media
  assign secondary_media = product.media[1]

  assign is_register_interest = false
  if is_register_interest_force == true
    assign is_register_interest = true
  endif

  assign page_coll_handle = collection.handle | default: '' | downcase
  assign page_coll_title = collection.title | default: '' | downcase
  if page_coll_handle contains 'interest' or page_coll_handle contains 'register' or page_coll_title contains 'interest' or page_coll_title contains 'register' or template.suffix contains 'interest'
    assign is_register_interest = true
  endif

  assign tags_combined = product.tags | join: ' ' | downcase
  if tags_combined contains 'register' or tags_combined contains 'interest' or tags_combined contains 'prototype'
    assign is_register_interest = true
  endif

  for prod_coll in product.collections
    assign prod_coll_handle = prod_coll.handle | downcase
    assign prod_coll_title = prod_coll.title | downcase
    if prod_coll_handle contains 'interest' or prod_coll_handle contains 'register' or prod_coll_title contains 'interest' or prod_coll_title contains 'register'
      assign is_register_interest = true
      break
    endif
  endfor
-%}

<div class="product-card{% if is_register_interest %} product-card-interest{% endif %}" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}" data-product-title="{{ product.title | escape }}">
  <!-- Self-contained Product JSON for instant, offline, password-safe Quick View rendering -->
  <script type="application/json" class="product-card-json" data-product-handle="{{ product.handle }}">
    {{ product | json }}
  </script>

  <div class="card-media">
    <a href="{{ product.url }}" class="media-link" aria-label="{{ product.title | escape }}">
      {%- if featured_media -%}
        {{ featured_media | image_url: width: 750 | image_tag: 
          loading: 'lazy', 
          widths: '375, 550, 750',
          class: 'primary-img',
          alt: featured_media.alt | default: product.title | escape 
        }}
        {%- if secondary_media and settings.show_secondary_image -%}
          {{ secondary_media | image_url: width: 750 | image_tag: 
            loading: 'lazy', 
            widths: '375, 550, 750',
            class: 'hover-img',
            alt: secondary_media.alt | default: product.title | escape 
          }}
        {%- endif -%}
      {%- else -%}
        <div class="placeholder-image">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </a>

    <!-- Luxury Status Badges -->
    <div class="card-badges">
      {%- if is_register_interest -%}
        <span class="badge badge-gold">CONCEPT PROTOTYPE</span>
        <span class="badge badge-dark">VOTE ONLY</span>
      {%- elsif current_variant.available == false -%}
        <span class="badge badge-sold-out">SOLD OUT</span>
      {%- elsif product.compare_at_price > product.price -%}
        {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
        <span class="badge badge-sale">-{{ savings }}% OFF</span>
      {%- elsif product.tags contains 'bestseller' -%}
        <span class="badge badge-gold">BESTSELLER</span>
      {%- elsif product.tags contains 'new' -%}
        <span class="badge badge-new">NEW DROP</span>
      {%- elsif product.tags contains 'vault' -%}
        <span class="badge badge-dark">VAULT ARCHIVE</span>
      {%- endif -%}
    </div>

    <!-- Quick View Trigger (Icon Only - Function Intact Without Text) -->
    <button 
      type="button" 
      class="quick-view-btn" 
      data-quick-view
      data-product-handle="{{ product.handle }}"
      data-quick-view-trigger="{{ product.handle }}" 
      aria-label="Quick View {{ product.title | escape }}"
      title="Quick View"
    >
      {% render 'icon-eye' %}
    </button>
  </div>

  <div class="card-content">
    {%- assign vendor_clean = product.vendor | default: '' | strip -%}
    {%- assign vendor_lower = vendor_clean | downcase -%}
    {%- assign shop_lower = shop.name | downcase -%}
    {%- if settings.show_vendor and vendor_clean != blank and vendor_lower != 'my store' and vendor_lower != shop_lower -%}
      <div class="card-category">
        {{ vendor_clean }}
      </div>
    {%- elsif product.type != blank -%}
      <div class="card-category">
        {{ product.type }}
      </div>
    {%- endif -%}

    <h3 class="card-title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <!-- Price or Prototype Concept Status -->
    <div class="card-price-row">
      {%- if is_register_interest -%}
        <div class="interest-concept-status">
          <span class="concept-dot">●</span>
          <span>CONCEPT SILHOUETTE &bull; NOT FOR PURCHASE</span>
        </div>
      {%- else -%}
        {% render 'price', product: product, use_variant: true %}
      {%- endif -%}
    </div>

    <!-- Options Previews (Lengths or Colors) -->
    {%- unless is_register_interest -%}
      {%- for option in product.options_with_values -%}
        {%- assign opt_name = option.name | downcase -%}
        {%- if opt_name contains 'length' -%}
          <div class="card-lengths-preview">
            {%- for val in option.values limit: 4 -%}
              <span class="length-pill-preview">{{ val }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endunless -%}

    <!-- Action Buttons: Voting Pills for Register Interest OR Standard Buy Now -->
    {%- if is_register_interest -%}
      <div class="card-actions card-interest-actions" data-interest-card data-product-handle="{{ product.handle }}" data-product-title="{{ product.title | escape }}">
        <button 
          type="button" 
          class="btn-interest-pill btn-interest-yes" 
          data-vote-btn="interested"
          data-product-handle="{{ product.handle }}"
          aria-label="I am interested in {{ product.title | escape }}"
          title="Vote Interested"
        >
          <span class="vote-icon">▲</span>
          <span class="vote-label">INTERESTED</span>
          <span class="vote-count-badge" data-count="interested">0</span>
        </button>

        <button 
          type="button" 
          class="btn-interest-pill btn-interest-no" 
          data-vote-btn="not_interested"
          data-product-handle="{{ product.handle }}"
          aria-label="Not interested in {{ product.title | escape }}"
          title="Vote Pass"
        >
          <span class="vote-icon">▼</span>
          <span class="vote-label">PASS</span>
          <span class="vote-count-badge" data-count="not_interested">0</span>
        </button>
      </div>
    {%- else -%}
      <div class="card-actions">
        {%- if current_variant.available -%}
          <button 
            type="button" 
            class="btn-buy-now" 
            data-buy-now 
            data-variant-id="{{ current_variant.id }}"
            data-product-handle="{{ product.handle }}"
            aria-label="Buy {{ product.title | escape }} now"
          >
            <span>BUY NOW</span>
          </button>
          <button 
            type="button" 
            class="btn-add-bag" 
            data-add-to-cart 
            data-variant-id="{{ current_variant.id }}"
            data-product-handle="{{ product.handle }}"
            aria-label="Add {{ product.title | escape }} to bag"
          >
            {% render 'icon-shopping-bag' %}
          </button>
        {%- else -%}
          <a 
            href="{{ product.url }}" 
            class="btn-buy-now btn-sold-out" 
            aria-label="View {{ product.title | escape }}"
            title="View details and register interest"
          >
            <span>SOLD OUT &bull; VIEW DETAILS</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% comment %}
  LACEYAAN Luxury Editorial Product Card
  Matches high-fashion streetwear catalog aesthetic (Reference Image)
  Features rounded portrait image, bookmark ribbon, carousel dots, minimal info row with plus (+) quick action.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = product.featured_media
  assign secondary_media = product.media[1]

  assign is_register_interest = false
  if is_register_interest_force == true
    assign is_register_interest = true
  endif

  assign page_coll_handle = collection.handle | default: '' | downcase
  assign page_coll_title = collection.title | default: '' | downcase
  if page_coll_handle contains 'interest' or page_coll_handle contains 'register' or page_coll_title contains 'interest' or page_coll_title contains 'register' or template.suffix contains 'interest'
    assign is_register_interest = true
  endif

  assign tags_combined = product.tags | join: ' ' | downcase
  if tags_combined contains 'register' or tags_combined contains 'interest' or tags_combined contains 'prototype'
    assign is_register_interest = true
  endif

  for prod_coll in product.collections
    assign prod_coll_handle = prod_coll.handle | downcase
    assign prod_coll_title = prod_coll.title | downcase
    if prod_coll_handle contains 'interest' or prod_coll_handle contains 'register' or prod_coll_title contains 'interest' or prod_coll_title contains 'register'
      assign is_register_interest = true
      break
    endif
  endfor
-%}

<div class="product-card product-card-editorial{% if is_register_interest %} product-card-interest{% endif %}" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}" data-product-title="{{ product.title | escape }}">
  <!-- Self-contained Product JSON for instant, offline, password-safe Quick View rendering -->
  <script type="application/json" class="product-card-json" data-product-handle="{{ product.handle }}">
    {{ product | json }}
  </script>

  <!-- Editorial Rounded Media Container -->
  <div class="card-media">
    <a href="{{ product.url }}" class="media-link" data-open-studio-modal data-product-handle="{{ product.handle }}" aria-label="{{ product.title | escape }}">
      {%- if featured_media -%}
        {{ featured_media | image_url: width: 750 | image_tag: 
          loading: 'lazy', 
          widths: '375, 550, 750',
          class: 'primary-img',
          alt: featured_media.alt | default: product.title | escape 
        }}
        {%- if secondary_media and settings.show_secondary_image -%}
          {{ secondary_media | image_url: width: 750 | image_tag: 
            loading: 'lazy', 
            widths: '375, 550, 750',
            class: 'hover-img',
            alt: secondary_media.alt | default: product.title | escape 
          }}
        {%- endif -%}
      {%- else -%}
        <div class="placeholder-image">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </a>

    <!-- Top-Right Bookmark Ribbon Icon (Streetwear Tag matching reference) -->
    <button type="button" class="card-bookmark-btn" aria-label="Save to Wishlist" title="Save silhouette" onclick="this.classList.toggle('is-saved')">
      <svg class="icon-bookmark-ribbon" width="13" height="17" viewBox="0 0 14 18" fill="currentColor">
        <path d="M1 1H13V17L7 12.5L1 17V1Z"></path>
      </svg>
    </button>

    <!-- Bottom-Center Carousel Dots -->
    <div class="card-carousel-dots" aria-hidden="true">
      <span class="dot active"></span>
      <span class="dot"></span>
      <span class="dot"></span>
    </div>
  </div>

  <!-- Editorial Info Row directly below image -->
  <div class="card-content">
    <div class="card-info-row">
      <div class="card-details-col">
        <h3 class="card-title">
          <a href="{{ product.url }}" data-open-studio-modal data-product-handle="{{ product.handle }}">{{ product.title }}</a>
        </h3>
        <div class="card-price-row">
          {%- if is_register_interest -%}
            <span class="price-prototype">CONCEPT SILHOUETTE</span>
          {%- else -%}
            <span class="price-now">{{ product.price | money }}</span>
          {%- endif -%}
        </div>
      </div>

      <!-- Minimalist Bare Plus (+) Quick-Action Button -->
      <button 
        type="button" 
        class="card-action-plus-btn" 
        data-action-plus
        data-variant-id="{{ current_variant.id }}"
        data-product-handle="{{ product.handle }}"
        data-available="{{ current_variant.available }}"
        data-has-variants="{% if product.variants.size > 1 %}true{% else %}false{% endif %}"
        data-is-prototype="{% if is_register_interest %}true{% else %}false{% endif %}"
        aria-label="Quick Action for {{ product.title | escape }}"
        title="{% if current_variant.available %}Quick add to bag{% else %}View details & register interest{% endif %}"
      >
        <span class="plus-symbol">+</span>
      </button>
    </div>

    <!-- Voting Pills for Register Interest Silhouettes -->
    {%- if is_register_interest -%}
      <div class="card-interest-pills-row" data-interest-card data-product-handle="{{ product.handle }}" data-product-title="{{ product.title | escape }}">
        <button 
          type="button" 
          class="btn-interest-pill btn-interest-yes" 
          data-vote-btn="interested"
          data-product-handle="{{ product.handle }}"
          aria-label="I am interested in {{ product.title | escape }}"
          title="Vote Interested"
        >
          <span class="vote-icon">▲</span>
          <span class="vote-label">INTERESTED</span>
          <span class="vote-count-badge" data-count="interested">0</span>
        </button>

        <button 
          type="button" 
          class="btn-interest-pill btn-interest-no" 
          data-vote-btn="not_interested"
          data-product-handle="{{ product.handle }}"
          aria-label="Not interested in {{ product.title | escape }}"
          title="Vote Pass"
        >
          <span class="vote-icon">▼</span>
          <span class="vote-label">PASS</span>
          <span class="vote-count-badge" data-count="not_interested">0</span>
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

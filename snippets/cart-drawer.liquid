{% comment %}
  Real-Time Ajax Cart Drawer with Free Shipping Calculator & Upsells
{% endcomment %}

<div id="cart-drawer-overlay" class="cart-drawer-overlay" data-cart-close aria-hidden="true"></div>

<div id="cart-drawer" class="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-heading" aria-hidden="true">
  <!-- Drawer Header -->
  <div class="drawer-header">
    <div class="drawer-title-group">
      {% render 'icon-shopping-bag' %}
      <h2 id="cart-drawer-heading" class="drawer-title">
        {{ 'sections.cart.title' | t }}
        <span class="drawer-count" id="cart-drawer-count" data-cart-count>({{ cart.item_count }})</span>
      </h2>
    </div>
    <button type="button" class="drawer-close-btn" id="close-cart-drawer" data-cart-close aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon-close' %}
    </button>
  </div>

  <!-- Free Shipping Progress Bar -->
  {%- assign threshold_amount = settings.free_shipping_threshold | default: 1499 | times: 100 -%}
  <div class="shipping-progress-container" data-threshold="{{ threshold_amount }}">
    <div class="shipping-progress-text" id="shipping-progress-text">
      {%- if cart.total_price >= threshold_amount -%}
        <div class="shipping-unlocked">
          {% render 'icon-sparkles' %}
          <span>{{ 'sections.cart.free_shipping_eligible' | t }}</span>
        </div>
      {%- else -%}
        {%- assign remaining = threshold_amount | minus: cart.total_price -%}
        <div class="shipping-remaining">
          <span>Add <strong>{{ remaining | money }}</strong> more for Complimentary Express Shipping</span>
        </div>
      {%- endif -%}
    </div>
    {%- assign progress_pct = cart.total_price | times: 100.0 | divided_by: threshold_amount | at_most: 100 -%}
    <div class="shipping-progress-bar">
      <div class="shipping-progress-fill" id="shipping-progress-fill" style="width: {{ progress_pct }}%;"></div>
    </div>
  </div>

  <!-- Items Body -->
  <div class="drawer-body">
    <div class="cart-empty-state" id="cart-drawer-empty"{% if cart.item_count > 0 %} style="display: none;"{% endif %}>
      <div class="empty-icon-wrap">
        {% render 'icon-shopping-bag' %}
      </div>
      <p class="empty-heading">{{ 'sections.cart.empty' | t }}</p>
      <p class="empty-subtext">Discover slow shuttle-loom weaves, weighted brass aglets, and bespoke sneaker upgrades.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn-primary" id="drawer-continue-shopping">
        {{ 'sections.cart.continue_shopping' | t }}
      </a>
    </div>

    <div class="cart-items-list" id="cart-drawer-items"{% if cart.item_count == 0 %} style="display: none;"{% endif %}>
      {%- for item in cart.items -%}
        <div class="cart-item-card" data-line="{{ forloop.index }}">
          <div class="cart-item-image-wrapper">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.title | escape }}" class="cart-item-img" width="80" height="80" loading="lazy">
            {%- endif -%}
          </div>
          <div class="cart-item-content">
            <div class="cart-item-header">
              <h4 class="cart-item-title">
                <a href="{{ item.url }}">{{ item.product.title }}</a>
              </h4>
              <button type="button" class="cart-item-remove" data-cart-item-action="remove" data-item-line="{{ forloop.index }}" aria-label="Remove {{ item.title | escape }}">
                {% render 'icon-close' %}
              </button>
            </div>

            {%- unless item.product.has_only_default_variant -%}
              <div class="cart-item-options">
                {%- for option in item.options_with_values -%}
                  <span class="item-option-pill">{{ option.name }}: {{ option.value }}</span>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <div class="cart-item-footer">
              <div class="cart-qty-control">
                <button type="button" class="qty-btn" data-cart-item-action="minus" data-item-line="{{ forloop.index }}" data-item-qty="{{ item.quantity }}" aria-label="Decrease quantity">-</button>
                <input type="number" class="qty-input" value="{{ item.quantity }}" min="1" data-cart-quantity-input data-item-line="{{ forloop.index }}">
                <button type="button" class="qty-btn" data-cart-item-action="plus" data-item-line="{{ forloop.index }}" data-item-qty="{{ item.quantity }}" aria-label="Increase quantity">+</button>
              </div>
              <div class="cart-item-price">
                {{ item.final_line_price | money }}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <!-- Drawer Footer (Subtotal & Checkout) -->
  <div class="drawer-footer" id="cart-drawer-filled"{% if cart.item_count == 0 %} style="display: none;"{% endif %}>
    {%- if settings.enable_cart_notes -%}
      <div class="cart-note-container">
        <label for="cart-note-input">{{ 'sections.cart.note' | t }}</label>
        <textarea id="cart-note" class="cart-note-input" placeholder="Custom lengths, shoe model (e.g. Jordan 1, Samba, Chelsea boot)...">{{ cart.note }}</textarea>
      </div>
    {%- endif -%}

    <div class="drawer-subtotal-row">
      <span class="subtotal-label">{{ 'sections.cart.subtotal' | t }}</span>
      <span class="subtotal-amount" id="cart-drawer-subtotal">{{ cart.total_price | money }}</span>
    </div>
    <p class="drawer-shipping-notice">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>

    <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form">
      <button type="submit" name="checkout" class="btn-primary btn-checkout">
        {% render 'icon-shield-check' %}
        <span>{{ 'sections.cart.checkout' | t }}</span>
      </button>
    </form>
  </div>
</div>

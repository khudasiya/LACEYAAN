{% comment %}
  Ajax Quick View Modal with dynamic variant selection and gallery
{% endcomment %}

<div id="quick-view-overlay" class="quick-view-overlay" data-modal-close aria-hidden="true"></div>

<div id="quick-view-modal" class="quick-view-modal" role="dialog" aria-modal="true" aria-labelledby="quick-view-title" aria-hidden="true">
  <button type="button" class="modal-close-btn" id="close-quick-view" data-modal-close aria-label="{{ 'accessibility.close' | t }}">
    {% render 'icon-close' %}
  </button>

  <div class="quick-view-content" id="quick-view-content">
    <div class="quick-view-loading">
      <span class="spinner"></span>
      <p>{{ 'accessibility.loading' | t }}</p>
    </div>
  </div>
</div>
